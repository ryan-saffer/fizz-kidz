{
    "compilerOptions": {
        "target": "ES2017",
        "lib": ["dom", "dom.iterable", "esnext"],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "module": "Preserve",
        "moduleResolution": "Bundler",
        "moduleDetection": "force",
        "isolatedModules": true,
        "jsx": "preserve",
        "incremental": true,
        "paths": {
            "@fizz-kidz/core": ["../../packages/core/src"],
            "@fizz-kidz/ui": ["../../packages/ui/src"]
        }
    },
    "include": ["**/*.ts", "**/*.tsx"],
    "exclude": ["node_modules"]
}
