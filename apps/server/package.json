{
    "name": "server",
    "private": true,
    "description": "Cloud Functions for Firebase",
    "main": "dist/index.js",
    "scripts": {
        "build": "vp pack",
        "build:watch": "vp pack --watch",
        "dev:build": "FUNCTIONS_EMULATOR=true vp pack",
        "dev:build:watch": "FUNCTIONS_EMULATOR=true vp pack --watch",
        "dev:typecheck": "vp exec tsc --noEmit --watch --preserveWatchOutput",
        "deploy": "vp exec firebase deploy --only functions",
        "logs": "vp exec firebase functions:log",
        "script:dev": "FIREBASE_CONFIG='{ \"projectId\": \"booking-system-6435d\" }' vp exec tsx ./scripts/main.ts",
        "script:prod": "FIREBASE_CONFIG='{ \"projectId\": \"bookings-prod\" }' vp exec tsx ./scripts/main.ts"
    },
    "dependencies": {
        "@google-cloud/pubsub": "^3.7.1",
        "@sanity/client": "^7.26.2",
        "@sanity/image-url": "^2.1.1",
        "@sendgrid/mail": "^7.7.0",
        "@sentry/node": "^10.30.0",
        "@sparticuz/chromium": "^121.0.0",
        "@trpc/server": "11.16.0",
        "acuityscheduling": "^0.1.9",
        "canvas": "^3.2.3",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "firebase-admin": "^11.11.0",
        "firebase-functions": "^4.4.1",
        "googleapis": "^105.0.0",
        "luxon": "^2.4.0",
        "mixpanel": "^0.18.0",
        "mjml": "4.14.1",
        "mustache": "^4.2.0",
        "puppeteer-core": "23.2.1",
        "qrcode": "^1.5.4",
        "square": "42.1.0",
        "stripe": "^10.17.0",
        "xero-node": "^4.34.0",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@sentry/rollup-plugin": "^4.6.1",
        "@types/express": "^4.17.6",
        "@types/luxon": "^2.3.2",
        "@types/mjml": "4.7.1",
        "@types/mjml-core": "4.7.1",
        "@types/mustache": "^4.2.2",
        "@types/node": "^22.19.0",
        "@types/prompts": "^2.4.9",
        "@types/qrcode": "^1.5.5",
        "@types/request": "^2.48.8",
        "@types/stripe": "^7.13.23",
        "csv-parse": "^5.3.0",
        "firebase-functions-test": "^0.1.7",
        "mockdate": "^3.0.5",
        "prompts": "^2.4.2",
        "tsx": "^4.23.1",
        "typescript": "npm:@typescript/typescript6@^6.0.2"
    },
    "engines": {
        "node": "22"
    }
}
