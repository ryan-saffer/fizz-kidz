<mjml>
    <mj-head>
        <mj-attributes>
            <mj-all font-family="'Trebuchet MS', 'Helvetica Neue', Helvetica, Arial, sans-serif"></mj-all>
            <mj-text
                font-weight="400"
                font-size="16px"
                color="#000000"
                line-height="24px"
                font-family="'Helvetica Neue', Helvetica, Arial, sans-serif"
            ></mj-text>
        </mj-attributes>
        <mj-style inline="inline">
            .text-link {
                color: #5e6ebf;
            }
            .pre-wrap {
                white-space: pre-wrap;
            }
        </mj-style>
        <mj-style inline="inline">
            .footer-link {
                color: #888888;
            }
        </mj-style>
    </mj-head>
    <mj-body background-color="#E7E7E7" width="600px">
        <mj-section background-color="#EEC73A" padding-bottom="0px">
            <mj-column width="100%">
                <mj-spacer height="30px" />
                <mj-text font-family="Trebuchet MS" color="white" align="center" font-size="30px" line-height="40px">
                    {{#rescheduled}}Preschool Program session rescheduled{{/rescheduled}} {{^rescheduled}}Preschool
                    Program booking confirmation{{/rescheduled}}
                </mj-text>
            </mj-column>
        </mj-section>
        <mj-section background-color="#ffffff" padding-top="0">
            <mj-column>
                <mj-image src="https://i.imgur.com/5DI7BbY.png" width="600px" alt="" padding="0" />
            </mj-column>
        </mj-section>
        <mj-wrapper padding-top="0" padding-bottom="0">
            <mj-section background-color="#ffffff" padding-left="15px" padding-right="15px" padding-top="0">
                <mj-column width="100%">
                    <mj-text font-size="16px"> Hi {{ parentName }}, </mj-text>
                    {{#rescheduled}}
                    <mj-text font-size="16px">
                        Your Preschool Program session has been rescheduled. Here are your updated session details. You
                        can use the Change / Cancel link if you need to make another change.
                    </mj-text>
                    {{/rescheduled}} {{^rescheduled}}
                    <mj-text font-size="16px">
                        Yay! Your Fizz Kidz Preschool Program booking is confirmed and paid. We can't wait to welcome
                        your child into the studio.
                    </mj-text>
                    <mj-text font-size="16px">
                        Below are the sessions you have booked. You can use the Change / Cancel link beside each session
                        if you need to manage an individual booking.
                    </mj-text>
                    {{/rescheduled}}
                </mj-column>
                <mj-column width="100%">
                    <mj-text
                        color="#212b35"
                        font-size="12px"
                        text-transform="uppercase"
                        font-weight="bold"
                        padding-bottom="0"
                    >
                        Location
                    </mj-text>
                    <mj-text font-size="14px" padding-top="0" mj-class="pre-wrap"> {{{location}}} </mj-text>
                </mj-column>
                <mj-column width="100%">
                    <mj-text
                        color="#212b35"
                        font-size="12px"
                        text-transform="uppercase"
                        font-weight="bold"
                        padding-bottom="0"
                    >
                        When / Who
                    </mj-text>
                    <mj-text font-size="14px" padding-top="0">
                        {{#bookings}}
                        <p style="font-size: 14px; font-weight: 500; margin-bottom: 0; margin-top: 8px">
                            {{ time }} - <a href="{{confirmationPage}}">Change / Cancel</a>
                        </p>
                        <p style="margin: 0; font-size: 13px">
                            {{ details }}{{#isFullTermDiscount}} - 20% full-term discount applied{{/isFullTermDiscount}}
                        </p>
                        {{/bookings}}
                    </mj-text>
                </mj-column>
                <mj-column width="100%">
                    <mj-text font-size="16px">
                        The Preschool Program is a 2-hour session for children aged 2.5 to 5 years. Each week brings a
                        new hands-on science, art and sensory adventure, with a consistent session structure that builds
                        confidence, independence and school-readiness through intentional play.
                    </mj-text>
                    <mj-text font-size="16px">
                        Children enjoy creative projects, sensory exploration, science experiments, movement, music and
                        story time, and take home their creations each week.
                    </mj-text>
                    <mj-text font-size="16px">
                        <strong>{{ policy.title }}</strong>
                        {{#policy.paragraphs}}
                        <p>{{.}}</p>
                        {{/policy.paragraphs}}
                    </mj-text>
                    <mj-text font-size="16px">
                        If you have any questions, just reply to this email or call us on
                        <a href="tel:+61390598144">(03) 9059 8144</a>.
                    </mj-text>
                    <mj-text font-size="16px"> See you soon! </mj-text>
                    <mj-text font-size="16px"> The Fizz Kidz Team </mj-text>
                </mj-column>
                {{#receiptUrl}}
                <mj-column width="100%"
                    ><mj-text align="center"
                        ><a href="{{receiptUrl}}">Click here for a copy of your payment receipt</a></mj-text
                    ></mj-column
                >
                {{/receiptUrl}}
            </mj-section>
        </mj-wrapper>
        <mj-wrapper full-width="full-width">
            <mj-section padding-top="0">
                <mj-group>
                    <mj-column width="100%" padding-right="0">
                        <mj-text color="#445566" font-size="11px" align="center" line-height="16px" font-weight="bold">
                            <a class="footer-link" href="mailto:bookings@fizzkidz.com.au">bookings@fizzkidz.com.au</a
                            >&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;<a
                                class="footer-link"
                                href="https://www.fizzkidz.com.au"
                                >www.fizzkidz.com.au</a
                            >
                        </mj-text>
                    </mj-column>
                </mj-group>
            </mj-section>
        </mj-wrapper>
    </mj-body>
</mjml>
