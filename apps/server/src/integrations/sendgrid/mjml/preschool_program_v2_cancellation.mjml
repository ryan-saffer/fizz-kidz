<mjml>
    <mj-head>
        <mj-attributes>
            <mj-all font-family="'Trebuchet MS', 'Helvetica Neue', Helvetica, Arial, sans-serif"></mj-all>
            <mj-text
                font-weight="400"
                font-size="16px"
                color="#000000"
                line-height="24px"
                font-family="'Helvetica Neue', Helvetica, Arial, sans-serif"
            ></mj-text>
        </mj-attributes>
        <mj-style inline="inline">
            .footer-link {
                color: #888888;
            }
            .pre-wrap {
                white-space: pre-wrap;
            }
        </mj-style>
    </mj-head>
    <mj-body background-color="#E7E7E7" width="600px">
        <mj-section background-color="#EEC73A" padding-bottom="0px">
            <mj-column width="100%">
                <mj-spacer height="30px" />
                <mj-text font-family="Trebuchet MS" color="white" align="center" font-size="30px" line-height="40px">
                    Preschool Program cancellation
                </mj-text>
            </mj-column>
        </mj-section>
        <mj-section background-color="#ffffff" padding-top="0">
            <mj-column>
                <mj-image src="https://i.imgur.com/5DI7BbY.png" width="600px" alt="" padding="0" />
            </mj-column>
        </mj-section>
        <mj-section background-color="#ffffff" padding-left="15px" padding-right="15px" padding-top="0">
            <mj-column width="100%">
                <mj-text font-size="16px"> Hi {{ parentName }}, </mj-text>
                <mj-text font-size="16px"> Your Preschool Program session has been cancelled. </mj-text>
            </mj-column>
            <mj-column width="100%">
                <mj-text
                    color="#212b35"
                    font-size="12px"
                    text-transform="uppercase"
                    font-weight="bold"
                    padding-bottom="0"
                >
                    Booking
                </mj-text>
                <mj-text font-size="14px" padding-top="0"> {{ booking }} </mj-text>
            </mj-column>
            <mj-column width="100%">
                <mj-text
                    color="#212b35"
                    font-size="12px"
                    text-transform="uppercase"
                    font-weight="bold"
                    padding-bottom="0"
                >
                    Location
                </mj-text>
                <mj-text font-size="14px" padding-top="0" mj-class="pre-wrap"> {{{location}}} </mj-text>
            </mj-column>
            {{#hasRefund}}
            <mj-column width="100%">
                <mj-text font-size="16px"> A refund of ${{ refundAmount }} has been processed. </mj-text>
            </mj-column>
            {{/hasRefund}}
            {{^hasRefund}}
            <mj-column width="100%">
                <mj-text font-size="16px">
                    No refund was processed. This happens when a session is cancelled less than 48 hours before it
                    starts, or when cancelling it removes the full-term discount from the rest of your booking. See our
                    policy below.
                </mj-text>
            </mj-column>
            {{/hasRefund}}
            <mj-column width="100%">
                <mj-text
                    color="#212b35"
                    font-size="12px"
                    text-transform="uppercase"
                    font-weight="bold"
                    padding-bottom="0"
                >
                    {{ policy.title }}
                </mj-text>
                <mj-text font-size="16px">
                    {{#policy.paragraphs}}
                    <p>{{.}}</p>
                    {{/policy.paragraphs}}
                </mj-text>
            </mj-column>
            {{#receiptUrl}}
            <mj-column width="100%"
                ><mj-text align="center"
                    ><a href="{{receiptUrl}}">Click here for a copy of your payment receipt</a></mj-text
                ></mj-column
            >
            {{/receiptUrl}}
            <mj-column width="100%">
                <mj-text font-size="16px">
                    If you have any questions, please reply to this email or call us on
                    <a href="tel:+61390598144">(03) 9059 8144</a>.
                </mj-text>
                <mj-text font-size="16px"> The Fizz Kidz Team </mj-text>
            </mj-column>
        </mj-section>
        <mj-wrapper full-width="full-width">
            <mj-section padding-top="0">
                <mj-group>
                    <mj-column width="100%" padding-right="0">
                        <mj-text color="#445566" font-size="11px" align="center" line-height="16px" font-weight="bold">
                            <a class="footer-link" href="mailto:bookings@fizzkidz.com.au">bookings@fizzkidz.com.au</a
                            >&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;<a
                                class="footer-link"
                                href="https://www.fizzkidz.com.au"
                                >www.fizzkidz.com.au</a
                            >
                        </mj-text>
                    </mj-column>
                </mj-group>
            </mj-section>
        </mj-wrapper>
    </mj-body>
</mjml>
