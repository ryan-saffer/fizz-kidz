---
import Image from "@/components/image.astro";
import logo from "@/assets/images/logo-white.png";
import { RECALL_LABEL, RECALL_URL } from "@/utils/constants";
import { PUBLIC_STUDIOS } from "@/utils/studios";

const exploreLinks = [
  { label: "Birthday parties", href: "/birthday-parties/" },
  { label: "Holiday programs", href: "/holiday-programs/" },
  { label: "Preschool program", href: "/preschool-program/" },
  { label: "After school program", href: "/after-school-programs/" },
  { label: "Incursions", href: "/in-schools/incursions/" },
  { label: "Activations & events", href: "/activations-and-events/" },
];

const companyLinks = [
  { label: "Gift cards", href: "/gift-cards/" },
  { label: "Careers", href: "/careers/" },
  { label: "Own a studio", href: "/franchising/" },
  { label: "Contact us", href: "/contact-us/" },
];

const currentYear = new Date().getFullYear();
---

<footer id="footer" class="bg-[#19131f] font-gotham text-white">
  <div aria-hidden="true" class="grid h-2 grid-cols-5">
    <div class="bg-[#9044E2]"></div>
    <div class="bg-[#F24DA2]"></div>
    <div class="bg-[#F6BA33]"></div>
    <div class="bg-[#4FE16D]"></div>
    <div class="bg-[#42D4F3]"></div>
  </div>

  <div class="mx-auto w-full max-w-7xl px-6 py-8 sm:px-8 lg:py-16">
    <div class="grid border-b border-white/10 pb-8 lg:grid-cols-12 lg:gap-8 lg:pb-12">
      <div class="max-w-md pb-8 lg:col-span-5 lg:pb-0 lg:pr-12">
        <a href="/" class="inline-block rounded-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-[#F6BA33] focus-visible:ring-offset-4 focus-visible:ring-offset-[#19131f]">
          <Image
            src={logo}
            alt="Fizz Kidz"
            widths={[160, 240]}
            sizes="(min-width: 640px) 240px, 160px"
            class="h-20 w-20 object-contain sm:h-32 sm:w-32"
          />
        </a>
        <p class="mt-3 max-w-sm text-sm font-medium leading-6 text-white/70 sm:mt-5 sm:text-base">
          Creative parties, programs and experiences where kids can experiment,
          make and celebrate.
        </p>
        <a
          href="/locations/"
          class="mt-5 inline-flex items-center gap-2 rounded-full bg-[#9044E2] px-5 py-3 font-lilita text-sm uppercase tracking-wide transition-colors hover:bg-[#F6BA33] hover:text-[#19131f] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#F6BA33] focus-visible:ring-offset-4 focus-visible:ring-offset-[#19131f] lg:mt-7"
        >
          Find your nearest studio
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-4 w-4"
          >
            <path d="M5 12h14"></path>
            <path d="m13 6 6 6-6 6"></path>
          </svg>
        </a>
      </div>

      <div class="border-y border-white/10 lg:hidden">
        <details class="group">
          <summary class="flex cursor-pointer list-none items-center justify-between py-4 font-lilita text-lg tracking-wide text-[#42D4F3] focus:outline-none focus-visible:underline focus-visible:underline-offset-4 [&::-webkit-details-marker]:hidden">
            Explore
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-4 w-4 transition-transform group-open:rotate-180"
            >
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </summary>
          <ul class="grid grid-cols-2 gap-x-4 gap-y-3 pb-5 text-sm font-medium text-white/70">
            {
              exploreLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="transition-colors hover:text-white focus:outline-none focus-visible:text-white focus-visible:underline focus-visible:underline-offset-4"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
        <details class="group border-t border-white/10">
          <summary class="flex cursor-pointer list-none items-center justify-between py-4 font-lilita text-lg tracking-wide text-[#4FE16D] focus:outline-none focus-visible:underline focus-visible:underline-offset-4 [&::-webkit-details-marker]:hidden">
            Fizz Kidz
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-4 w-4 transition-transform group-open:rotate-180"
            >
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </summary>
          <ul class="grid grid-cols-2 gap-x-4 gap-y-3 pb-5 text-sm font-medium text-white/70">
            {
              companyLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="transition-colors hover:text-white focus:outline-none focus-visible:text-white focus-visible:underline focus-visible:underline-offset-4"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
      </div>

      <nav aria-labelledby="footer-explore" class="hidden lg:col-span-2 lg:block">
        <h2 id="footer-explore" class="font-lilita text-lg tracking-wide text-[#42D4F3]">
          Explore
        </h2>
        <ul class="mt-5 space-y-3 text-sm font-medium text-white/70">
          {
            exploreLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="transition-colors hover:text-white focus:outline-none focus-visible:text-white focus-visible:underline focus-visible:underline-offset-4"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-labelledby="footer-company" class="hidden lg:col-span-2 lg:block">
        <h2 id="footer-company" class="font-lilita text-lg tracking-wide text-[#4FE16D]">
          Fizz Kidz
        </h2>
        <ul class="mt-5 space-y-3 text-sm font-medium text-white/70">
          {
            companyLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="transition-colors hover:text-white focus:outline-none focus-visible:text-white focus-visible:underline focus-visible:underline-offset-4"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="pt-8 lg:col-span-3 lg:pt-0">
        <h2 class="font-lilita text-lg tracking-wide text-[#F6BA33]">Get in touch</h2>
        <address class="mt-5 space-y-3 text-sm font-medium not-italic text-white/70">
          <a
            href="tel:+61390598144"
            class="flex w-fit items-center gap-3 transition-colors hover:text-white focus:outline-none focus-visible:text-white focus-visible:underline focus-visible:underline-offset-4"
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-4 w-4 shrink-0 text-[#F6BA33]"
            >
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.69 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.33 1.85.56 2.81.69A2 2 0 0 1 22 16.92z"></path>
            </svg>
            (03) 9059 8144
          </a>
          <a
            href="mailto:bookings@fizzkidz.com.au"
            class="flex w-fit items-center gap-3 transition-colors hover:text-white focus:outline-none focus-visible:text-white focus-visible:underline focus-visible:underline-offset-4"
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-4 w-4 shrink-0 text-[#F6BA33]"
            >
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            bookings@fizzkidz.com.au
          </a>
        </address>
        <a
          href="https://www.instagram.com/fizzkidzz/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Follow Fizz Kidz on Instagram"
          class="mt-4 inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/15 text-white/70 transition-colors hover:border-[#F24DA2] hover:bg-[#F24DA2] hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#F24DA2] focus-visible:ring-offset-4 focus-visible:ring-offset-[#19131f] lg:mt-6"
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-5 w-5"
          >
            <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <path d="M17.5 6.5h.01"></path>
          </svg>
        </a>
      </div>
    </div>

    <section aria-labelledby="footer-studios" class="border-b border-white/10 py-6 lg:py-8">
      <div class="flex items-center justify-between gap-6 lg:items-start">
        <div class="max-w-xs">
          <h2 id="footer-studios" class="font-lilita text-lg tracking-wide">
            Our studios
          </h2>
          <p class="mt-2 text-sm leading-6 text-white/55">
            Find creative fun close to home.
          </p>
        </div>
        <a
          href="/locations/"
          class="shrink-0 text-sm font-medium text-white/70 underline decoration-white/30 underline-offset-4 transition-colors hover:text-white focus:outline-none focus-visible:text-white lg:hidden"
        >
          View all
        </a>
        <ul class="hidden flex-1 gap-x-6 gap-y-4 lg:grid lg:max-w-4xl lg:grid-cols-6">
          {
            PUBLIC_STUDIOS.map((studio) => (
              <li>
                <a
                  href={`/locations/${studio.slug}/`}
                  class="group flex w-fit items-center gap-2 text-sm font-medium text-white/70 transition-colors hover:text-white focus:outline-none focus-visible:text-white focus-visible:underline focus-visible:underline-offset-4"
                >
                  <span class="h-1.5 w-1.5 rounded-full bg-[#9044E2] transition-colors group-hover:bg-[#F6BA33]" />
                  {studio.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <div class="flex flex-col gap-4 pt-6 text-xs leading-5 text-white/50 lg:flex-row lg:items-end lg:justify-between lg:pt-8">
      <div>
        <p>&copy; {currentYear} Fizz Kidz Australia Pty Ltd. All rights reserved.</p>
        <p class="mt-2">
          Product safety recall: {RECALL_LABEL}.{" "}
          <a
            href={RECALL_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="text-white/70 underline decoration-white/30 underline-offset-4 transition-colors hover:text-white focus:outline-none focus-visible:text-white"
          >
            View recall notice
          </a>
        </p>
      </div>
      <nav aria-label="Legal">
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          <li>
            <a
              href="/policies/#privacy"
              class="transition-colors hover:text-white focus:outline-none focus-visible:text-white focus-visible:underline focus-visible:underline-offset-4"
            >
              Privacy policy
            </a>
          </li>
          <li>
            <a
              href="/policies/"
              class="transition-colors hover:text-white focus:outline-none focus-visible:text-white focus-visible:underline focus-visible:underline-offset-4"
            >
              Policies
            </a>
          </li>
          <li>
            <a
              href="/contact-us/"
              class="transition-colors hover:text-white focus:outline-none focus-visible:text-white focus-visible:underline focus-visible:underline-offset-4"
            >
              Contact
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</footer>
