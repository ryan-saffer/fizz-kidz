---
import "@/styles/globals.css";
import Header from "@/layout/header.astro";
import Footer from "@/layout/footer.astro";
import RecallBanner from "@/layout/recall-banner.astro";
import { ClientRouter } from "astro:transitions";
import LoadingIndicator from "astro-loading-indicator/component";
import { absoluteUrl, createSchemaGraph, type JsonLd } from "@/utils/seo";

type Props = {
  title: string;
  description: string;
  noIndex?: boolean;
  schema?: JsonLd | JsonLd[];
};

const { title, description, noIndex = false, schema = [] } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImage = absoluteUrl("/open-graph/home.jpg");
const schemaItems = Array.isArray(schema) ? schema : [schema];
const schemaGraph = createSchemaGraph({
  path: Astro.url.pathname,
  title,
  description,
  items: schemaItems,
});
---

<style is:global>
  .no-scroll {
    /* position: fixed;
    overflow-y: hidden; */
    display: none;
    width: 100%;
  }
</style>

<script is:inline>
  /**
   * This allows navigation directly to a hash route, where it will smoothly scroll after arriving on the page.
   */
  document.addEventListener("astro:page-load", () => {
    if (window.location.hash) {
      const target = document.querySelector(window.location.hash);
      if (target) {
        setTimeout(() => {
          target.scrollIntoView({ behavior: "smooth" });
        }, 100); // A slight delay to ensure the page has fully loaded
      }
    }
  });
</script>

<html lang="en-AU" transition:animate="none" class="h-full">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-NBCZ5XHQ");
    </script>
    <!-- End Google Tag Manager -->
    <meta charset="utf-8" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:site_name" content="Fizz Kidz" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="A child smiling at Fizz Kidz" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="A child smiling at Fizz Kidz" />
    <link rel="canonical" href={canonicalUrl} />
    {
      !noIndex && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(schemaGraph).replace(/</g, "\\u003c")}
        />
      )
    }

    <slot name="head" />
    <ClientRouter />
  </head>

  <LoadingIndicator color="#9044E2" height="3px" threshold={400} />
  <body class="flex flex-col">
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-NBCZ5XHQ"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <RecallBanner />
    <Header />
    <aside aria-label="Werribee Open Day" class="bg-[#FFDC5D] print:hidden">
      <a
        href="/locations/werribee/#open-day"
        class="group mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-[#542785] lg:justify-center lg:gap-6 lg:px-5 lg:py-4"
      >
        <div class="min-w-0 lg:flex lg:items-center lg:gap-6">
          <p class="font-lilita text-lg leading-tight text-[#542785] lg:text-2xl">
            Werribee is opening!
          </p>
          <p class="mt-1 font-gotham text-xs leading-snug lg:mt-0 lg:text-base">
            <span class="lg:hidden">Open Day &middot; Sat 19 Sept</span>
            <span class="hidden lg:inline">Join our Open Day on <span class="whitespace-nowrap font-semibold">Saturday 19th September</span></span>
            <span class="mx-1" aria-hidden="true">&middot;</span>
            <span class="whitespace-nowrap font-semibold">$15 per child</span>
          </p>
        </div>
        <span class="shrink-0 text-xl text-[#542785] lg:rounded-full lg:bg-[#9044E2] lg:px-5 lg:py-2 lg:font-lilita lg:text-base lg:text-white lg:transition-colors lg:group-hover:bg-[#7732BE]">
          <span class="sr-only lg:not-sr-only">Explore sessions &amp; book</span>
          <span class="lg:ml-1" aria-hidden="true">&rarr;</span>
        </span>
      </a>
    </aside>
    <div id="main">
      <slot class="flex-1" />
    </div>
    <Footer />
  </body>
</html>
