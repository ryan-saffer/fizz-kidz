---
import Image from "@/components/image.astro";
import logoHorizontal from "@/assets/images/logo-horizontal.png";
import NavigationMenu from "@/react-components/navigation/navigation-menu";
import { createNavigationMenu } from "@/react-components/navigation/navigation-menu-data";
import { buttonVariants } from "@/components/react/ui/button";
import { cn } from "@/components/react/lib/utils";
import { birthdayPartyPackageNavigationLinks } from "@/data/birthday-party-catalogue";

const menu = createNavigationMenu(birthdayPartyPackageNavigationLinks);
---

<header
  class="sticky top-0 z-[99] flex h-16 justify-center bg-white px-2 py-2 shadow-lg min-[1280px]:h-20 min-[1280px]:px-8"
>
  <div
    class="flex w-full flex-row-reverse items-center justify-end gap-4 min-[1280px]:flex-row min-[1280px]:justify-between"
  >
    <div
      class="absolute right-2 flex gap-2 min-[1280px]:right-8 min-[1280px]:hidden"
    >
      <a
        href="/franchising"
        class={cn(
          buttonVariants(),
          "bg-[#9044E2] p-2 font-lilita text-sm uppercase hover:bg-[#F6BA33] sm:p-6 sm:text-lg",
        )}>Own a studio</a
      >
      <a
        href="/contact-us/#contact"
        class={cn(
          buttonVariants(),
          "bg-[#9044E2] p-2 font-lilita text-sm uppercase hover:bg-[#F6BA33] sm:p-6 sm:text-lg",
        )}>Get in touch</a
      >
    </div>
    <a href="/" aria-label="Fizz Kidz home">
      <Image
        src={logoHorizontal}
        alt="Fizz Kidz"
        widths={[100, 300]}
        sizes="(min-width: 250px) 100, (min-width: 350px) 300"
        loading="eager"
        class="[min-1280px]:block hidden h-12 w-fit min-[450px]:block min-[1212px]:block min-[1280px]:h-16"
      />
    </a>
    <div class="flex items-center">
      <NavigationMenu menu={menu} client:load />
      <div class="flex gap-2">
        <a
          href="/franchising"
          class={cn(
            buttonVariants(),
            "hidden bg-[#9044E2] p-6 font-lilita text-lg uppercase hover:bg-[#F6BA33] min-[1440px]:inline-flex",
          )}>Own a studio</a
        >
        <a
          href="/contact-us/#contact"
          class={cn(
            buttonVariants(),
            "hidden bg-[#9044E2] p-6 font-lilita text-lg uppercase hover:bg-[#F6BA33] min-[1440px]:inline-flex",
          )}>Get in touch</a
        >
      </div>
    </div>
  </div>
</header>
