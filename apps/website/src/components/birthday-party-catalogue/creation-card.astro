---
import FlipCreation from "@/components/flip-creation.astro";

import type { BirthdayPartyCreationCard } from "@fizz-kidz/core";

type Props = {
  card: BirthdayPartyCreationCard;
  flippable?: boolean;
};

const { card, flippable = true } = Astro.props;
---

<FlipCreation
  color={card.colour}
  flippable={flippable}
  image={card.image}
  imageAlt={card.alt}
  text={card.label}
/>
