---
import FlipCreation from "../flip-creation.astro";

import { websiteCreationsTsBraceletsPng as creation } from "@/data/website-images";
type Props = {
  flippable?: boolean;
};

const { flippable = true } = Astro.props;
---

<FlipCreation
  flippable={flippable}
  image={creation}
  text={["Friendship Bracelets"]}
  color="pink"
/>
