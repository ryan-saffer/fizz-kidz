---
import FlipCreation from "../flip-creation.astro";

import { websiteCreationsSnakePotionsPng as creation } from "@/data/website-images";

type Props = {
  flippable?: boolean;
};

const { flippable = true } = Astro.props;
---

<FlipCreation
  flippable={flippable}
  image={creation}
  text={["Slithering Snake Potions"]}
  color="green"
/>
