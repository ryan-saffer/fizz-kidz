---
import FlipCreation from "../flip-creation.astro";

import { websiteCreationsGlitterFaceShimmerPng as creation } from "@/data/website-images";
type Props = {
  flippable?: boolean;
};

const { flippable = true } = Astro.props;
---

<FlipCreation
  flippable={flippable}
  image={creation}
  text={["Glitter Face Shimmer"]}
  color="yellow"
/>
