---
import FlipCreation from "../flip-creation.astro";

import { websiteCreationsFairyWandsPng as creation } from "@/data/website-images";
type Props = {
  flippable?: boolean;
};

const { flippable = true } = Astro.props;
---

<FlipCreation
  flippable={flippable}
  image={creation}
  text={["Fairy Wands"]}
  color="pink"
/>
