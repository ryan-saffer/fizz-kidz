---
import FlipCreation from "../flip-creation.astro";

import { websiteCreationsSquishyPocketsPng as creation } from "@/data/website-images";
type Props = {
  flippable?: boolean;
};

const { flippable = true } = Astro.props;
const textLines = "Squishy Kitty Pockets\n(Slime Inside!)".split("\n");
---

<FlipCreation
  flippable={flippable}
  image={creation}
  text={textLines}
  color="purple"
/>
