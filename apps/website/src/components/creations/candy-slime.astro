---
import FlipCreation from "../flip-creation.astro";

import { websiteCreationsCandySlimePng as creation } from "@/data/website-images";
type Props = {
  flippable?: boolean;
};

const { flippable = true } = Astro.props;
---

<FlipCreation
  flippable={flippable}
  image={creation}
  text={["Candy Slime"]}
  color="blue"
/>
