---
import FlipCreation from "../flip-creation.astro";

import { websiteCreationsSparklingLipBalmPng as creation } from "@/data/website-images";
type Props = {
  flippable?: boolean;
};

const { flippable = true } = Astro.props;
---

<!--Exact same as sparkling lip balm, just different text -->
<FlipCreation
  flippable={flippable}
  image={creation}
  text={["Fairy Lip Balm"]}
  color="purple"
/>
