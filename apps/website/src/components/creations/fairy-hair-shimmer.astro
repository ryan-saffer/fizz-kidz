---
import FlipCreation from "../flip-creation.astro";

import { websiteCreationsGlitterHairShimmerPng as creation } from "@/data/website-images";
type Props = {
  flippable?: boolean;
};

const { flippable = true } = Astro.props;
---

<!-- Exact same as glitter hair gel, just different text -->
<FlipCreation
  flippable={flippable}
  image={creation}
  text={["Fairy Hair Shimmer"]}
  color="blue"
/>
