---
import FlipCreation from "../flip-creation.astro";

import { websiteCreationsSlimeColourPng as creation } from "@/data/website-images";
type Props = {
  flippable?: boolean;
};

const { flippable = true } = Astro.props;
---

<FlipCreation
  flippable={flippable}
  image={creation}
  text={["Choose your colour"]}
  color="white"
/>
