---
type Props = {
  kind: "rocket" | "crown" | "bolt" | "smile" | "cloud" | "jar" | "dumpling" | "atom";
  class?: string;
};
const { kind, class: className } = Astro.props;
---

<svg class:list={["home-decal", className]} viewBox="0 0 120 150" fill="none" aria-hidden="true" focusable="false">
  {kind === "rocket" && <g stroke="#fff" stroke-width="5" stroke-linejoin="round" stroke-linecap="round">
    <path d="M45 107 34 141 60 126 70 144 82 108" fill="var(--fizz-yellow)" />
    <path d="M39 59 12 85 13 111 44 99M79 60 109 88 107 115 77 99" fill="var(--fizz-green)" />
    <path d="M60 7C35 26 30 62 38 99L58 116 80 99C91 63 86 29 60 7Z" fill="var(--fizz-pink)" />
    <path d="m43 26 35 2M36 90l45 1" />
    <circle cx="60" cy="60" r="16" fill="var(--fizz-blue)" stroke="var(--fizz-yellow)" stroke-width="7" />
    <path d="m52 53 8-5M53 127l-8 14M79 127l8 9" />
  </g>}
  {kind === "crown" && <g stroke="var(--fizz-yellow)" stroke-width="7" stroke-linejoin="round" stroke-linecap="round">
    <path d="m12 40 28 28 18-43 19 42 29-25-10 65-72 3Z" /><path d="m28 126 64-3" />
  </g>}
  {kind === "bolt" && <path d="m66 10-45 71 34-4-5 63 48-85-34 8Z" fill="var(--fizz-yellow)" stroke="#fff" stroke-width="6" stroke-linejoin="round" />}
  {kind === "smile" && <g stroke="var(--fizz-yellow)" stroke-width="6" stroke-linecap="round"><path d="M103 72c7 32-13 57-44 57S9 109 12 79s23-47 47-44c23-5 40 12 44 37Z" /><path d="m39 69 1 9m38-9 1 9M32 93q26 32 56-1" /></g>}
  {kind === "cloud" && <g stroke="var(--hero-navy)" stroke-width="3" stroke-linejoin="round"><path d="M21 109C0 105 0 80 16 73 6 51 30 38 44 47 48 23 78 25 86 48 106 41 118 62 107 77 127 92 110 116 92 111 79 130 54 120 51 116 36 126 24 120 21 109Z" fill="#ddbdff" stroke="#fff" stroke-width="6" /><ellipse cx="43" cy="84" rx="5" ry="7" fill="var(--hero-navy)" stroke="none" /><ellipse cx="80" cy="84" rx="5" ry="7" fill="var(--hero-navy)" stroke="none" /><path d="M53 95q8 10 16-1" stroke-linecap="round" /><ellipse cx="31" cy="98" rx="9" ry="5" fill="#ff94be" stroke="none" /><ellipse cx="91" cy="98" rx="9" ry="5" fill="#ff94be" stroke="none" /></g>}
  {kind === "jar" && <g stroke="#fff" stroke-width="4" stroke-linejoin="round"><path d="M23 42h76v82c-8 13-65 13-76 0Z" fill="var(--fizz-blue)" /><path d="M24 71q17-15 36 0t38-3v52c-17 12-58 10-74 0Z" fill="var(--fizz-green)" /><ellipse cx="61" cy="43" rx="38" ry="13" fill="var(--fizz-pink)" /><path d="m36 57-1 25m50 13v12" stroke-linecap="round" /><path d="m53 88 5-8 6 9 11 2-8 8 2 11-11-5-10 5 1-12-7-8Z" fill="var(--fizz-yellow)" stroke-width="2" /></g>}
  {kind === "atom" && <g stroke-linecap="round" stroke-linejoin="round">
    <g stroke="#fff" stroke-width="7"><ellipse cx="60" cy="75" rx="47" ry="17" /><ellipse cx="60" cy="75" rx="47" ry="17" transform="rotate(60 60 75)" /><ellipse cx="60" cy="75" rx="47" ry="17" transform="rotate(-60 60 75)" /></g>
    <g stroke-width="3"><ellipse cx="60" cy="75" rx="47" ry="17" stroke="var(--fizz-blue)" /><ellipse cx="60" cy="75" rx="47" ry="17" transform="rotate(60 60 75)" stroke="var(--fizz-green)" /><ellipse cx="60" cy="75" rx="47" ry="17" transform="rotate(-60 60 75)" stroke="var(--fizz-blue)" /></g>
    <circle cx="60" cy="75" r="9" fill="var(--fizz-green)" stroke="#fff" stroke-width="3" /><circle cx="100" cy="84" r="5" fill="var(--fizz-blue)" stroke="#fff" stroke-width="3" /><circle cx="40" cy="35" r="5" fill="var(--fizz-green)" stroke="#fff" stroke-width="3" />
  </g>}
  {kind === "dumpling" && <g stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 95C9 75 20 57 43 47C43 32 53 27 62 39C72 28 83 35 82 47C102 56 113 75 108 96C103 118 80 124 58 122C36 122 17 115 12 95Z" fill="#fff4dc" stroke="#fff" stroke-width="6" />
    <path d="M16 96C37 111 84 115 105 95C100 115 80 120 58 119C37 119 21 111 16 96Z" fill="#f7dcad" />
    <path d="M45 48Q44 57 35 65M56 44Q53 59 47 66M67 45Q69 57 76 65M80 48Q83 55 93 62" stroke="#dcb77e" stroke-width="3" /><path d="M23 77Q28 66 37 64" stroke="#fff" stroke-width="5" />
    <ellipse cx="43" cy="85" rx="4.3" ry="6" fill="var(--hero-navy)" /><ellipse cx="80" cy="85" rx="4.3" ry="6" fill="var(--hero-navy)" /><circle cx="44" cy="83" r="1.4" fill="#fff" /><circle cx="81" cy="83" r="1.4" fill="#fff" />
    <path d="M53 97Q61 109 70 97" stroke="var(--hero-navy)" stroke-width="3" /><ellipse cx="30" cy="98" rx="8" ry="4.5" fill="var(--fizz-pink)" opacity=".45" /><ellipse cx="93" cy="98" rx="8" ry="4.5" fill="var(--fizz-pink)" opacity=".45" />
  </g>}
</svg>
