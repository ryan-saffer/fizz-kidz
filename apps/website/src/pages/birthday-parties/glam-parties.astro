---
import PageIntro from "@/components/page-intro.astro";
import Layout from "@/layout/Layout.astro";
import PartyLayout from "@/layout/party-layout.astro";

import { websitePagesPartiesGlamPartiesJpg as glamParties } from "@/data/website-images";

import { websitePagesPartiesPackagesGlitzAndGlamPng as glitz } from "@/data/website-images";
import GlamCreations from "@/components/creation-packages/glam-creations.astro";
import { createPartySchemas } from "@/utils/seo";

const description =
  "A glittery kids glam birthday party with guided craft and take-home creations at Fizz Kidz studios in Melbourne and Geelong for children aged 4 to 12.";
---

<Layout
  title="Kids Glam Birthday Parties in Melbourne & Geelong | Fizz Kidz"
  description={description}
  schema={createPartySchemas({
    name: "Kids Glam Birthday Party",
    description,
    slug: "glam-parties",
  })}
>
  <PartyLayout partyPackage="Glam">
    <PageIntro
      slot="intro"
      subtitle="Bring the glitter, sparkles and fun to your child's next party!"
      type="image"
      image={glamParties}
      imageAlt="hands holding colourful body glitter containers"
      actionButtonText="Book a party"
      actionButtonPath="/birthday-parties/book-a-party/#book"
      color="pink"
    >
      <span slot="title">Glam Kids Birthday Party</span>
      <span slot="content">
        Make your very own sparkling and dazzling pamper products to take home
        with you after the party!
      </span>
    </PageIntro>
    <GlamCreations
      variant="party"
      image={glitz}
      imageAlt="Three girls smiling"
    />
  </PartyLayout>
</Layout>
