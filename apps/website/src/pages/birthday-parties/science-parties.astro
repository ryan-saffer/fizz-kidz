---
import PageIntro from "@/components/page-intro.astro";
import Layout from "@/layout/Layout.astro";
import PartyLayout from "@/layout/party-layout.astro";

import { websitePagesPartiesSciencePartyJpg as scienceParty } from "@/data/website-images";
import { websitePagesPartiesPackagesSciencePng as science } from "@/data/website-images";
import ScienceCreations from "@/components/creation-packages/science-creations.astro";
import { createPartySchemas } from "@/utils/seo";

const description =
  "A hands-on kids science birthday party with experiments and take-home creations, hosted by Fizz Kidz at studios across Melbourne and Geelong.";
---

<Layout
  title="Kids Science Birthday Parties in Melbourne & Geelong | Fizz Kidz"
  description={description}
  schema={createPartySchemas({
    name: "Kids Science Birthday Party",
    description,
    slug: "science-parties",
  })}
>
  <PartyLayout partyPackage="Science">
    <PageIntro
      slot="intro"
      subtitle="Fizz, Bubble, Explode! For all the little scientists out there, this is for you!"
      type="image"
      image={scienceParty}
      imageAlt="a kid in awe as her science experiment bubbles"
      actionButtonText="Book a party"
      actionButtonPath="/birthday-parties/book-a-party/#book"
      color="blue"
    >
      <span slot="title">Kids Science Birthday Parties</span>
      <span slot="content">
        Fizz Kidz science birthday parties are scientifically proven to be
        fizzing fantastic!
      </span>
    </PageIntro>
    <ScienceCreations
      variant="party"
      image={science}
      imageAlt="Science Party Package"
    />
  </PartyLayout>
</Layout>
