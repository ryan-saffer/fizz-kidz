---
import PageIntro from "@/components/page-intro.astro";
import Layout from "@/layout/Layout.astro";
import PartyLayout from "@/layout/party-layout.astro";

import { websitePagesPartiesUnicornPartyJpg as unicornParty } from "@/data/website-images";
import { websitePagesPartiesPackagesUnicornPng as unicorn } from "@/data/website-images";
import UnicornCreations from "@/components/creation-packages/unicorn-creations.astro";
import { createPartySchemas } from "@/utils/seo";

const description =
  "A magical unicorn birthday party with glittery craft, slime and take-home creations for children aged 4 to 12 at Fizz Kidz studios in Melbourne and Geelong.";
---

<Layout
  title="Unicorn Birthday Parties in Melbourne & Geelong | Fizz Kidz"
  description={description}
  schema={createPartySchemas({
    name: "Unicorn Birthday Party",
    description,
    slug: "unicorn-parties",
  })}
>
  <PartyLayout partyPackage="Unicorn">
    <PageIntro
      slot="intro"
      subtitle="Welcome to the magical world of Unicorns!"
      type="image"
      image={unicornParty}
      imageAlt="Colourful unicorn-themed soaps and craft creations"
      actionButtonText="Book a party"
      actionButtonPath="/birthday-parties/book-a-party/#book"
      color="pink"
    >
      <span slot="title">Unicorn Kids Birthday Parties</span>
      <span slot="content">
        Here we love everything sparkles, glitter and magic!
      </span>
    </PageIntro>
    <UnicornCreations
      variant="party"
      image={unicorn}
      imageAlt="Unicorn Party Package"
    />
  </PartyLayout>
</Layout>
