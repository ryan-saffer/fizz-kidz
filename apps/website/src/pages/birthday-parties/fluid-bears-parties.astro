---
import PageIntro from "@/components/page-intro.astro";
import Layout from "@/layout/Layout.astro";
import PartyLayout from "@/layout/party-layout.astro";

import { websitePagesPartiesFluidBearsPartyPng as fluidBears } from "@/data/website-images";
import { websitePagesPartiesPackagesFluidBearsWhitePng as fluidBearsPackage } from "@/data/website-images";
import FluidBearsCreations from "@/components/creation-packages/fluid-bears-creations.astro";
import { createPartySchemas } from "@/utils/seo";

const description =
  "A colourful Fluid Bears birthday party where kids create drip-art bear keyrings and take-home projects at Fizz Kidz studios in Melbourne and Geelong.";
---

<Layout
  title="Fluid Bears Birthday Parties in Melbourne & Geelong | Fizz Kidz"
  description={description}
  schema={createPartySchemas({
    name: "Fluid Bears Birthday Party",
    description,
    slug: "fluid-bears-parties",
  })}
>
  <PartyLayout partyPackage="Fluid Bears">
    <PageIntro
      slot="intro"
      subtitle="Mesmerizing Drip Art Fun!"
      type="image"
      image={fluidBears}
      imageAlt="A child creating colourful fluid bear drip art"
      actionButtonText="Book a party"
      actionButtonPath="/birthday-parties/book-a-party/#book"
      color="gold"
    >
      <span slot="title">Fluid Bears Kids Birthday Parties</span>
      <span slot="content"
        >Design your very own awesome bear keyring by dripping vibrant paint
        for a one-of-a-kind masterpiece that's yours to take home!</span
      >
    </PageIntro>
    <FluidBearsCreations
      variant="party"
      image={fluidBearsPackage}
      imageAlt="Fluid Bears Party Package"
    />
  </PartyLayout>
</Layout>
