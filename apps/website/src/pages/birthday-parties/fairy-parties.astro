---
import PageIntro from "@/components/page-intro.astro";
import Layout from "@/layout/Layout.astro";
import PartyLayout from "@/layout/party-layout.astro";

import { websitePagesPartiesFairyPartyWebp as fairyParty } from "@/data/website-images";
import { websitePagesPartiesPackagesFairiesPng as fairy } from "@/data/website-images";
import FairyCreations from "@/components/creation-packages/fairy-creations.astro";
import { createPartySchemas } from "@/utils/seo";

const description =
  "A hands-on fairy birthday party with magical craft, slime and take-home creations for kids aged 4 to 12 at Fizz Kidz studios in Melbourne and Geelong.";
---

<Layout
  title="Fairy Birthday Parties in Melbourne & Geelong | Fizz Kidz"
  description={description}
  schema={createPartySchemas({
    name: "Fairy Birthday Party",
    description,
    slug: "fairy-parties",
  })}
>
  <PartyLayout partyPackage="Fairy">
    <PageIntro
      slot="intro"
      subtitle="Welcome to the magical world of fairies!"
      type="image"
      image={fairyParty}
      imageAlt="Colourful fairy-themed soaps and craft creations"
      actionButtonText="Book a party"
      actionButtonPath="/birthday-parties/book-a-party/#book"
      color="pink"
    >
      <span slot="title">Fairy Kids Birthday Parties</span>
      <span slot="content">
        Here we love everything sparkles, glitter and magic!
      </span>
    </PageIntro>
    <FairyCreations
      variant="party"
      image={fairy}
      imageAlt="Fairy Party Package"
    />
  </PartyLayout>
</Layout>
