---
import PageIntro from "@/components/page-intro.astro";
import Layout from "@/layout/Layout.astro";
import PartyLayout from "@/layout/party-layout.astro";

import { websitePagesPartiesSlimePartyJpg as slime } from "@/data/website-images";
import { websitePagesPartiesSlimeCreationsHeroPng as slimePackage } from "@/data/website-images";
import SlimeLab from "@/components/slime-lab.astro";
import SlimeCreations from "@/components/creation-packages/slime-creations.astro";
import { createPartySchemas } from "@/utils/seo";

const description =
  "A hosted slime birthday party where kids mix, customise and take home their own slime creations at Fizz Kidz studios across Melbourne and Geelong.";
---

<Layout
  title="Kids Slime Birthday Parties in Melbourne & Geelong | Fizz Kidz"
  description={description}
  schema={createPartySchemas({
    name: "Kids Slime Birthday Party",
    description,
    slug: "slime-parties",
  })}
>
  <PartyLayout partyPackage="Slime">
    <PageIntro
      slot="intro"
      subtitle="Slime, slime and more slime!"
      type="image"
      image={slime}
      imageAlt="a kid holding a long stretch of slime and smiling"
      actionButtonText="Book a party"
      actionButtonPath="/birthday-parties/book-a-party/#book"
      color="purple"
    >
      <span slot="title">Kids Slime Birthday Parties</span>
      <span slot="content">
        For all the slime lovers out there, we love slime just as much! Together
        lets get messy and make the most perfect slimes!
      </span>
    </PageIntro>
    <SlimeCreations
      variant="party"
      image={slimePackage}
      imageAlt="Slime Party Package"
    />
    <SlimeLab />
  </PartyLayout>
</Layout>
