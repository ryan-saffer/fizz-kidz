---
import PageIntro from "@/components/page-intro.astro";
import Layout from "@/layout/Layout.astro";
import PartyLayout from "@/layout/party-layout.astro";

import { websitePagesPartiesTieDyePartyJpg as tieDye } from "@/data/website-images";
import { websitePagesPartiesPackagesTieDyePng as tieDyePackage } from "@/data/website-images";
import TieDyeCreations from "@/components/creation-packages/tie-dye-creations.astro";
import { createPartySchemas } from "@/utils/seo";

const description =
  "A colourful tie dye birthday party with guided, hands-on projects children can take home, hosted at Fizz Kidz studios in Melbourne and Geelong.";
---

<Layout
  title="Kids Tie Dye Birthday Parties in Melbourne & Geelong | Fizz Kidz"
  description={description}
  schema={createPartySchemas({
    name: "Kids Tie Dye Birthday Party",
    description,
    slug: "tie-dye-parties",
  })}
>
  <PartyLayout partyPackage="Tie Dye">
    <PageIntro
      slot="intro"
      subtitle="Tie Dye birthday parties are the best kids parties!"
      type="image"
      image={tieDye}
      imageAlt="tie dyed shoelaces"
      actionButtonText="Book a party"
      actionButtonPath="/birthday-parties/book-a-party/#book"
      color="pink"
    >
      <span slot="title">Tie Dye Kids Birthday Party</span>
      <span slot="content">
        Enjoy the process of Tie Dying your favourite items and take the item
        home to enjoy!
      </span>
    </PageIntro>
    <TieDyeCreations
      variant="party"
      image={tieDyePackage}
      imageAlt="Tie Dye Party Package"
    />
  </PartyLayout>
</Layout>
