---
import PageIntro from "@/components/page-intro.astro";
import Layout from "@/layout/Layout.astro";
import PartyLayout from "@/layout/party-layout.astro";

import { websitePagesPartiesSafariPartyJpg as jungleSafariParty } from "@/data/website-images";
import { websiteCreationsBubblingVolcanoesPng as bubblingVocanoes } from "@/data/website-images";
import JungleSafariCreations from "@/components/creation-packages/jungle-safari-creations.astro";
import { createPartySchemas } from "@/utils/seo";

const description =
  "A jungle-themed kids birthday party with guided science, slime, bath bomb and potion creations at Fizz Kidz studios in Melbourne and Geelong.";
---

<Layout
  title="Jungle Safari Birthday Parties in Melbourne & Geelong | Fizz Kidz"
  description={description}
  schema={createPartySchemas({
    name: "Jungle Safari Birthday Party",
    description,
    slug: "jungle-safari-parties",
  })}
>
  <PartyLayout partyPackage="Jungle Safari">
    <PageIntro
      slot="intro"
      subtitle="Roar! Welcome to the jungle!"
      type="image"
      image={jungleSafariParty}
      imageAlt="Children enjoying a jungle-themed Fizz Kidz party"
      actionButtonText="Book a party"
      actionButtonPath="/birthday-parties/book-a-party/#book"
      color="green"
    >
      <span slot="title">Jungle Safari Kids Birthday Parties</span>
      <span slot="content">
        Join the safari adventure and make your own jungle creations!
      </span>
    </PageIntro>
    <JungleSafariCreations
      variant="party"
      image={bubblingVocanoes}
      imageAlt="Jungle Safari Party Package"
    />
  </PartyLayout>
</Layout>
