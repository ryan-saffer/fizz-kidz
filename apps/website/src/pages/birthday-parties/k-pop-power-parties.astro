---
import PageIntro from "@/components/page-intro.astro";
import Layout from "@/layout/Layout.astro";
import PartyLayout from "@/layout/party-layout.astro";

import { websitePagesPartiesKPopDemonHuntersPartyPng as kpopparty } from "@/data/website-images";
import { websitePagesPartiesPackagesKPopDemonHuntersPng as kpop } from "@/data/website-images";
import KPopPowerCreations from "@/components/creation-packages/k-pop-power-creations.astro";
import { createPartySchemas } from "@/utils/seo";

const description =
  "A high-energy K-Pop Power birthday party with music-inspired craft and take-home creations at Fizz Kidz studios in Melbourne and Geelong.";
---

<Layout
  title="K-Pop Power Birthday Parties in Melbourne & Geelong | Fizz Kidz"
  description={description}
  schema={createPartySchemas({
    name: "K-Pop Power Birthday Party",
    description,
    slug: "k-pop-power-parties",
  })}
>
  <PartyLayout partyPackage="K-Pop Power">
    <PageIntro
      slot="intro"
      subtitle="The ultimate K-Pop party experience!"
      type="image"
      image={kpopparty}
      imageAlt="Colourful K-Pop Power party creations"
      actionButtonText="Book a party"
      actionButtonPath="/birthday-parties/book-a-party/#book"
      color="purple"
    >
      <span slot="title">Kids K-Pop Power Parties</span>
      <span slot="content">
        Step into a world of magic and music where K-Pop energy meets fantasy
        adventure!
      </span>
    </PageIntro>
    <KPopPowerCreations
      variant="party"
      image={kpop}
      imageAlt="K-Pop Power Party Package"
    />
  </PartyLayout>
</Layout>
