---
import PageIntro from "@/components/page-intro.astro";
import Layout from "@/layout/Layout.astro";
import PartyLayout from "@/layout/party-layout.astro";

import { websitePagesPartiesTaylorSwiftPartyJpg as taylorSwiftParty } from "@/data/website-images";
import { websitePagesPartiesPackagesSwiftiePng as taylorSwiftPackage } from "@/data/website-images";
import TaylorSwiftCreations from "@/components/creation-packages/taylor-swift-creations.astro";
import { createPartySchemas } from "@/utils/seo";

const description =
  "A Swiftie-inspired kids birthday party with sparkling, music-themed craft and take-home creations at Fizz Kidz studios in Melbourne and Geelong.";
---

<Layout
  title="Swiftie-Inspired Birthday Parties in Melbourne & Geelong | Fizz Kidz"
  description={description}
  schema={createPartySchemas({
    name: "Swiftie-Inspired Kids Birthday Party",
    description,
    slug: "taylor-swift-parties",
  })}
>
  <PartyLayout partyPackage="Taylor Swift">
    <PageIntro
      slot="intro"
      subtitle="Join us for the best Swiftie Party!"
      type="image"
      image={taylorSwiftParty}
      imageAlt="Sparkling Swiftie-inspired party creations"
      actionButtonText="Book a party"
      actionButtonPath="/birthday-parties/book-a-party/#book"
      color="purple"
    >
      <span slot="title">Taylor Swift Kids Birthday Party</span>
      <span slot="content"
        >Make your very own sparkling and dazzling Swiftie creations to take
        home with you after the party!</span
      >
    </PageIntro>
    <TaylorSwiftCreations
      variant="party"
      image={taylorSwiftPackage}
      imageAlt="Taylor Swift Party Package"
    />
  </PartyLayout>
</Layout>
