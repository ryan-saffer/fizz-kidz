---
import PageIntro from "@/components/page-intro.astro";
import { BreadcrumbWrapper } from "@/components/react/breadcrumb-wrapper";
import Layout from "@/layout/Layout.astro";
import { websitePagesPartiesCreationsHeroJpg as hero } from "@/data/website-images";
import KPopPowerCreations from "@/components/creation-packages/k-pop-power-creations.astro";
import GlamCreations from "@/components/creation-packages/glam-creations.astro";
import ScienceCreations from "@/components/creation-packages/science-creations.astro";
import SlimeCreations from "@/components/creation-packages/slime-creations.astro";
import FairyCreations from "@/components/creation-packages/fairy-creations.astro";
import FluidBearsCreations from "@/components/creation-packages/fluid-bears-creations.astro";
import JungleSafariCreations from "@/components/creation-packages/jungle-safari-creations.astro";
import UnicornCreations from "@/components/creation-packages/unicorn-creations.astro";
import TieDyeCreations from "@/components/creation-packages/tie-dye-creations.astro";
import TaylorSwiftCreations from "@/components/creation-packages/taylor-swift-creations.astro";
---

<Layout
  title="Choose Your Super Creative Kids Birthday Party in Melbourne"
  description="View all our creation options here!"
>
  <main class="m-auto block max-w-[1380px] px-5 pt-4">
    <div class="h-[10px]"></div>
    <BreadcrumbWrapper
      items={[
        { type: "link", title: "Birthday Parties", path: "/birthday-parties/" },
        {
          type: "link",
          title: "Creations",
          path: "/birthday-parties/creations/",
        },
      ]}
    />
    <PageIntro
      type="image"
      image={hero}
      imageAlt="A line of colourful smocks hanging up"
      subtitle="View all our creation options here"
      color="pink"
      actionButtonText="Book a party"
      actionButtonPath="/birthday-parties/book-a-party/#book"
    >
      <span slot="title">Fizz Kidz Creations</span>
    </PageIntro>
    <section class="mt-12 md:mt-40">
      <KPopPowerCreations />
      <GlamCreations />
      <ScienceCreations />
      <SlimeCreations />
      <FairyCreations />
      <FluidBearsCreations />
      <JungleSafariCreations />
      <UnicornCreations />
      <TieDyeCreations />
      <TaylorSwiftCreations />
    </section>
  </main>
</Layout>
