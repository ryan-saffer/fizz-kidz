---
import WaveBottom from "@/assets/svg/wave-bottom.svg";
import WaveTop from "@/assets/svg/wave-top.svg";
import CardWithImage from "@/components/card-with-image.astro";
import Container from "@/components/container.astro";
import GoogleReviews from "@/components/google-reviews.astro";
import Image from "@/components/image.astro";
import LocationDetails from "@/components/location-details.astro";
import PageIntro from "@/components/page-intro.astro";
import { BreadcrumbWrapper } from "@/components/react/breadcrumb-wrapper";
import { Button } from "@/components/react/ui/button";
import ImageCarousel from "@/components/react/image-carousel";
import {
  websitePagesHomeEnergyJpg as contact,
  websitePagesHomeHolidayProgramsJpg as holidayPrograms,
  websitePagesHomePartiesJpg as birthday,
  websitePagesLocationsWerribeeWerribee1Png as werribee1,
  websitePagesLocationsWerribeeWerribee2Jpg as werribee2,
  websitePagesLocationsWerribeeWerribee3Jpg as werribee3,
  websitePagesLocationsWerribeeWerribee4Jpg as werribee4,
  websitePagesLocationsWerribeeWerribee5Jpg as werribee5,
  websitePagesLocationsWerribeeWerribee6Webp as werribee6,
  werribeeOpenDay1,
  werribeeOpenDay2,
  werribeeOpenDay4,
} from "@/data/website-images";
import Layout from "@/layout/Layout.astro";
import { locationMenuLinks } from "@/react-components/navigation/navigation-menu-data";
import { createLocationSchemas } from "@/utils/seo";

const description =
  "Visit Fizz Kidz Werribee at Harpley Town Center for hosted kids birthday parties, school holiday programs and hands-on slime, science, art and craft activities.";
---

<Layout
  title="Kids Parties & Holiday Programs in Werribee | Fizz Kidz"
  description={description}
  schema={createLocationSchemas("werribee")}
>
  <main>
    <div class="m-auto block max-w-[1380px] px-5 pt-4">
      <BreadcrumbWrapper
        client:idle
        items={[
          {
            type: "link",
            title: "Locations",
            path: "/locations",
          },
          {
            type: "dropdown",
            title: "Werribee",
          items: locationMenuLinks,
          },
        ]}
      />
      <PageIntro
        type="image"
        image={werribee1}
        imageAlt="Inside the Fizz Kidz Werribee studio"
        subtitle="Creative kids' fun in Melbourne's west"
        color="purple"
        actionButtonPath="/contact-us"
        actionButtonText="Get in touch"
      >
        <span slot="title">Fizz Kidz Werribee Studio</span>
        <span slot="content"
          >Our Werribee studio is a colourful, hands-on destination where kids
          can create, celebrate and have loads of fun!</span
        >
      </PageIntro>
    </div>
    <WaveTop
      aria-hidden="true"
      focusable="false"
      class="-mb-px mt-12 block h-8 w-full text-[#FF7518] sm:h-16 lg:h-20"
    />
    <div id="halloween" class="scroll-mt-24 bg-[#FF7518] py-4">
      <div class="m-auto block max-w-[1380px] px-5">
        <div class="mx-auto max-w-2xl text-center lg:max-w-5xl">
          <p class="mb-3 font-gotham text-sm font-semibold uppercase tracking-widest text-black">Join us for</p>
          <h2 class="font-lilita text-4xl uppercase sm:text-6xl">Halloween <span class="whitespace-nowrap">Spookfest!</span></h2>
          <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
            <p class="rounded-full bg-white/80 px-5 py-2 font-gotham text-sm font-semibold sm:text-base">
              Friday 30th October
            </p>
            <p class="rounded-full bg-[#9044E2] px-5 py-2 font-gotham text-sm font-semibold text-white sm:text-base">
              Just $20 per child
            </p>
          </div>
          <p class="mt-6 font-gotham text-lg leading-relaxed sm:text-xl">
            Spooky creations for kids aged 4 to 12, then a Tween Disco Night for ages 9 to 12!
          </p>
        </div>
        <a
          href="https://bookings.fizzkidz.com.au/programs?id=75381458"
          class="mt-6 flex justify-center"
        >
          <Button
            className="bg-[#9044E2] p-6 font-lilita text-lg uppercase hover:bg-[#542785]"
          >
            Book a Spookfest Session
          </Button>
        </a>
        <p class="mt-3 text-center font-gotham text-sm font-semibold">
          Limited spots available.
        </p>
        <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-3">
          <CardWithImage
            image={werribeeOpenDay2}
            imageAlt="Kids making spooky creations at Fizz Kidz Werribee"
          >
            <div slot="content" class="p-8">
              <p class="font-lilita text-3xl text-[#9044E2]">Session 1</p>
              <p class="mt-2 font-semibold">
                Friday 30th October<br />4:00pm - 5:00pm
              </p>
              <ul class="mb-4 mt-2 list-disc pl-4">
                <li>Cauldron Spider Explosions</li>
                <li>Spooky Jelly Soap</li>
              </ul>
            </div>
          </CardWithImage>
          <CardWithImage
            image={werribeeOpenDay1}
            imageAlt="Kids making glow slime at Fizz Kidz Werribee"
          >
            <div slot="content" class="p-8">
              <p class="font-lilita text-3xl text-[#EC65A6]">Session 2</p>
              <p class="mt-2 font-semibold">
                Friday 30th October<br />5:30pm - 6:30pm
              </p>
              <ul class="mb-4 mt-2 list-disc pl-4">
                <li>Ghost Glow Slime (glow-in-the-dark slime)</li>
                <li>Bat Attack Bath Bombs (hide a bat inside your bath bomb)</li>
              </ul>
            </div>
          </CardWithImage>
          <CardWithImage
            image={werribeeOpenDay4}
            imageAlt="Tweens creating at Fizz Kidz Werribee"
          >
            <div slot="content" class="p-8">
              <p class="font-lilita text-3xl text-[#9DCC46]">Spookfest Tween Disco Night</p>
              <p class="mt-2 font-semibold">
                Friday 30th October<br />7:00pm - 8:00pm
              </p>
              <p class="mt-1 text-sm font-semibold">For ages 9 to 12</p>
              <ul class="mb-4 mt-2 list-disc pl-4">
                <li>Glow Squishies</li>
                <li>Glow Crowns (made with glow-in-the-dark beads)</li>
              </ul>
            </div>
          </CardWithImage>
        </div>
        <a
          href="https://bookings.fizzkidz.com.au/programs?id=75381458"
          class="mt-6 flex justify-center"
        >
          <Button
            className="bg-[#9044E2] p-6 font-lilita text-lg uppercase hover:bg-[#542785]"
          >
            Book a Spookfest Session
          </Button>
        </a>
      </div>
    </div>
    <WaveBottom
      aria-hidden="true"
      focusable="false"
      class="-mt-px block h-8 w-full text-[#FF7518] sm:h-16 lg:h-20"
    />
    <Container>
      <p class="mt-16 text-center font-lilita text-5xl sm:mt-32">
        Creativity & fun at Harpley Town Center!
      </p>
      <section
        class="my-12 flex flex-col-reverse gap-8 md:pb-12 md:pt-16 lg:flex-row"
      >
        <div class="px-0 sm:px-12 lg:w-1/2">
          <Image
            class="rounded-2xl object-contain shadow-green-sm sm:shadow-green-md"
            src={werribee5}
            alt="The Fizz Kidz Werribee shopfront at Harpley Town Center"
          />
        </div>
        <div class="flex flex-col justify-center lg:w-1/2">
          <p class="font-bold">Fizz Kidz Werribee Studio</p>
          <p>T5, Harpley Town Center, Bradfield St, Werribee VIC 3030</p>
          <p class="mt-4 font-bold">Phone</p>
          <p><a href="tel:0390598144">(03) 9059 8144</a></p>
          <p class="mt-4 font-bold">Email</p>
          <p>
            <a href="mailto:bookings@fizzkidz.com.au"
              >bookings@fizzkidz.com.au</a
            >
          </p>
          <p class="mt-4 font-bold">About Fizz Kidz Werribee</p>
          <p>
            Our Werribee studio brings Fizz Kidz creativity to families in
            Melbourne's west.
          </p>
          <ul class="mb-4 list-disc pl-4">
            <li>Located in Harpley Town Center on Bradfield St.</li>
            <li>
              A vibrant space for hosted birthday parties, holiday programs and
              creative activities.
            </li>
            <li>
              Hands-on slime, science, art and craft experiences with creations
              for kids to take home.
            </li>
          </ul>
        </div>
      </section>

      <section class="mb-12 md:mb-20">
        <iframe
          title="Map showing Fizz Kidz Werribee"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3147.810572030706!2d144.6131446780955!3d-37.911490139633266!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6ad68592994a5fc9%3A0x4875f20b9af8bbc2!2sFizz%20Kidz%20Werribee!5e0!3m2!1sen!2sau!4v1786423710739!5m2!1sen!2sau"
          width="100%"
          height="450"
          style="border:0;border-radius:12px"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"></iframe>
      </section>

      <section class="grid grid-cols-1 gap-8 md:grid-cols-3">
        <a href="/birthday-parties">
          <CardWithImage
            className="group h-full w-full cursor-pointer hover:bg-gray-50"
            image={birthday}
            imageAlt="A child enjoying a Fizz Kidz birthday party"
          >
            <div slot="content" class="p-8 group-hover:cursor-pointer">
              <p class="mb-4 font-lilita text-2xl text-[#9044E2]">
                Birthday Parties
              </p>
              <p class="font-gotham text-lg">
                Celebrate with a fully hosted, hands-on party at Fizz Kidz
                Werribee, where kids make awesome creations to take home.
              </p>
            </div>
          </CardWithImage>
        </a>
        <a href="/holiday-programs">
          <CardWithImage
            className="group h-full w-full cursor-pointer hover:bg-gray-50"
            image={holidayPrograms}
            imageAlt="A child holding a colourful Fizz Kidz creation"
          >
            <div slot="content" class="p-8">
              <p class="mb-4 font-lilita text-2xl text-[#9044E2]">
                Holiday Programs
              </p>
              <p class="font-gotham text-lg">
                Fill the school holidays with guided activities, games and
                creative projects at Fizz Kidz Werribee.
              </p>
            </div>
          </CardWithImage>
        </a>
        <a href="/contact-us">
          <CardWithImage
            className="group h-full w-full cursor-pointer hover:bg-gray-50"
            image={contact}
            imageAlt="A child taking part in a creative Fizz Kidz activity"
          >
            <div slot="content" class="p-8">
              <p class="mb-4 font-lilita text-2xl text-[#9044E2]">Contact Us</p>
              <p class="font-gotham text-lg">
                Have questions or would like to chat? Get in touch with our
                Werribee team and we will be happy to help.
              </p>
            </div>
          </CardWithImage>
        </a>
      </section>

      <section class="mt-24">
        <p class="text-center font-lilita text-3xl">Werribee Studio Gallery</p>
        <ImageCarousel
          client:visible
          loop
          imageSlots={["image1", "image2", "image3", "image4", "image6", "image5"]}
        >
        <Image
          slot="image1"
          src={werribee1}
          alt="Fizz Kidz Werribee gallery photo 1"
          class="h-60 w-60 rounded-md object-cover"
          width={240}
          height={240}
          widths={[240, 480]}
          sizes="240px"
          fit="cover"
        />
        <Image
          slot="image2"
          src={werribee2}
          alt="Fizz Kidz Werribee gallery photo 2"
          class="h-60 w-60 rounded-md object-cover"
          width={240}
          height={240}
          widths={[240, 480]}
          sizes="240px"
          fit="cover"
        />
        <Image
          slot="image3"
          src={werribee3}
          alt="Fizz Kidz Werribee gallery photo 3"
          class="h-60 w-60 rounded-md object-cover"
          width={240}
          height={240}
          widths={[240, 480]}
          sizes="240px"
          fit="cover"
        />
        <Image
          slot="image4"
          src={werribee4}
          alt="Fizz Kidz Werribee gallery photo 4"
          class="h-60 w-60 rounded-md object-cover"
          width={240}
          height={240}
          widths={[240, 480]}
          sizes="240px"
          fit="cover"
        />
        <Image
          slot="image5"
          src={werribee5}
          alt="Fizz Kidz Werribee gallery photo 5"
          class="h-60 w-60 rounded-md object-cover"
          width={240}
          height={240}
          widths={[240, 480]}
          sizes="240px"
          fit="cover"
        />
        <Image
          slot="image6"
          src={werribee6}
          alt="Fizz Kidz Werribee gallery photo 6"
          class="h-60 w-60 rounded-md object-cover"
          width={240}
          height={240}
          widths={[240, 480]}
          sizes="240px"
          fit="cover"
        />
        </ImageCarousel>
      </section>

      <section>
        <GoogleReviews
          title="Hear what our parents have to say!"
          location="werribee"
        />
      </section>
    </Container>
    <LocationDetails studio="werribee" />
  </main>
</Layout>
