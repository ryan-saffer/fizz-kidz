---
import PageIntro from "@/components/page-intro.astro";
import { BreadcrumbWrapper } from "@/components/react/breadcrumb-wrapper";
import Layout from "@/layout/Layout.astro";
import { websitePagesLocationsEssendonJpg as essendon } from "@/data/website-images";
import { websitePagesLocationsKingsvilleBirthdayJpg as birthday } from "@/data/website-images";
import { websitePagesLocationsKingsvilleHolidayProgramsJpg as holidayPrograms } from "@/data/website-images";
import { websitePagesLocationsKingsvilleContactJpg as contact } from "@/data/website-images";
import { websitePagesLocationsKingsvilleSlimeJpg as slime } from "@/data/website-images";
import Image from "@/components/image.astro";
import CardWithImage from "@/components/card-with-image.astro";
import ImageCarousel from "@/components/react/image-carousel";
import GoogleReviews from "@/components/google-reviews.astro";
import LocationDetails from "@/components/location-details.astro";

import { websitePagesLocationsEssendonEssendon1Jpg as carousel1Image } from "@/data/website-images";
import { websitePagesLocationsEssendonEssendon2Jpg as carousel2Image } from "@/data/website-images";
import { websitePagesLocationsEssendonEssendon3Jpg as carousel3Image } from "@/data/website-images";
import { websitePagesLocationsEssendonEssendon4Jpg as carousel4Image } from "@/data/website-images";
import { websitePagesLocationsEssendonEssendon5Jpg as carousel5Image } from "@/data/website-images";
import { menu } from "@/components/react/navigation/navigation-menu";
import { createLocationSchemas } from "@/utils/seo";

const description =
  "Visit Fizz Kidz Essendon for hosted kids birthday parties, school holiday programs and hands-on slime, science, art and craft activities in Melbourne's north-west.";
---

<Layout
  title="Kids Parties & Holiday Programs in Essendon | Fizz Kidz"
  description={description}
  schema={createLocationSchemas("essendon")}
>
  <main>
  <div class="m-auto block max-w-[1380px] px-5 pt-4">
    <BreadcrumbWrapper
      client:idle
      items={[
        {
          type: "link",
          title: "Locations",
          path: "/locations",
        },
        {
          type: "dropdown",
          title: "Essendon",
          items: menu[5].items,
        },
      ]}
    />
    <PageIntro
      type="image"
      image={essendon}
      imageAlt="A picture of the essendon studio"
      subtitle="The Ultimate Kids' Destination of Fun"
      color="purple"
      actionButtonPath="/contact-us"
      actionButtonText="Get in touch"
    >
      <span slot="title">Fizz Kidz Essendon Studio</span>
      <span slot="content"
        >Our Essendon studio is a vibrant, hands-on, light filled space where
        kids unleash their creativity!
      </span>
    </PageIntro>
    <p class="mt-36 text-center font-lilita text-5xl">
      Creativity & fun in the heart of Essendon!
    </p>
    <section
      class="my-12 flex flex-col-reverse gap-8 md:pb-12 md:pt-16 lg:flex-row"
    >
      <div class="px-0 sm:px-12 lg:w-1/2">
        <Image
          class="rounded-2xl object-contain shadow-green-sm sm:shadow-green-md"
          src={slime}
          alt="Two Fizz Kids staff standing under an archway"
        />
      </div>
      <div class="flex flex-col justify-center lg:w-1/2">
        <p class="font-bold">Fizz Kidz Essendon Studio</p>
        <p>75 Raleigh St, Essendon VIC 3040</p>
        <p class="mt-4 font-bold">Phone</p>
        <p><a href="tel:0390598144">(03) 9059 8144</a></p>
        <p class="mt-4 font-bold">Email</p>
        <p>
          <a href="mailto:bookings@fizzkidz.com.au">bookings@fizzkidz.com.au</a>
        </p>
        <p class="mt-4 font-bold">About Fizz Kidz Essendon</p>
        <p>
          Our stunning Essendon studio is big, colourful and bright with lots of
          natural light.
          <ul class="mb-4 list-disc pl-4">
            <li>Amble four hour parking right outside</li>
            <li>Located next door to PEGS Junior College</li>
            <li>Accommodate up to 30 children at birthday parties</li>
            <li>
              Cafe for parents:
              <ul class="mb-4 list-[circle] pl-6">
                <li>
                  Pizza By D'Asporto is conveniently located right next door.
                  Parents are welcome to grab a coffee, or even a pizza!
                </li>
                <li>
                  Assembly Groud is another great cafe, located two minutes walk
                  down Napier street.
                </li>
              </ul>
            </li>
          </ul>
        </p>
      </div>
    </section>
    <section class="mb-12 md:mb-20">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3154.5740298803826!2d144.9160536775877!3d-37.7531364305785!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6ad65dc3246af4ab%3A0x141336d61c4cc492!2sFizz%20Kidz!5e0!3m2!1sen!2sau!4v1742120892841!5m2!1sen!2sau"
        width="100%"
        height="450"
        style="border:0;border-radius:12px"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </section>
    <section class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <a href="/birthday-parties">
        <CardWithImage
          className="group h-full w-full cursor-pointer"
          image={birthday}
          imageAlt="Kids holding slime"
        >
          <div
            slot="content"
            class="p-8 group-hover:cursor-pointer group-hover:bg-gray-50"
          >
            <p class="mb-4 font-lilita text-2xl text-[#9044E2]">
              Birthday Parties
            </p>
            <p class="font-gotham text-lg">
              Celebrate with a fun-filled, hands-on party at Fizz Kidz Essendon,
              where kids create and take home amazing creations!
            </p>
          </div>
        </CardWithImage>
      </a>
      <a href="/holiday-programs">
        <CardWithImage
          className="group h-full w-full cursor-pointer"
          image={holidayPrograms}
          imageAlt="Kids holding slime"
        >
          <div slot="content" class="p-8 group-hover:bg-gray-50">
            <p class="mb-4 font-lilita text-2xl text-[#9044E2]">
              Holiday Programs
            </p>
            <p class="font-gotham text-lg">
              Our Essendon holiday programs keep kids engaged with exciting
              activities, creative projects, and plenty of fun!
            </p>
          </div>
        </CardWithImage>
      </a>
      <a href="/contact-us">
        <CardWithImage
          className="group h-full w-full cursor-pointer"
          image={contact}
          imageAlt="Kids holding slime"
        >
          <div slot="content" class="p-8 group-hover:bg-gray-50">
            <p class="mb-4 font-lilita text-2xl text-[#9044E2]">Contact Us</p>
            <p class="font-gotham text-lg">
              Have questions or would like to chat? Get in touch with our
              Essendon team, we would love to help!
            </p>
          </div>
        </CardWithImage>
      </a>
    </section>
    <section class="mt-24">
      <p class="text-center font-lilita text-3xl">Essendon Studio Gallery</p>
      <ImageCarousel
        client:idle
        loop
        imageSlots={["image1", "image2", "image3", "image4", "image5"]}
      >
        <Image
          slot="image1"
          src={carousel1Image}
          alt="Fizz Kidz Essendon gallery photo 1"
          class="h-60 w-60 rounded-md object-cover"
          width={240}
          height={240}
          widths={[240, 480]}
          sizes="240px"
          fit="cover"
        />
        <Image
          slot="image2"
          src={carousel2Image}
          alt="Fizz Kidz Essendon gallery photo 2"
          class="h-60 w-60 rounded-md object-cover"
          width={240}
          height={240}
          widths={[240, 480]}
          sizes="240px"
          fit="cover"
        />
        <Image
          slot="image3"
          src={carousel3Image}
          alt="Fizz Kidz Essendon gallery photo 3"
          class="h-60 w-60 rounded-md object-cover"
          width={240}
          height={240}
          widths={[240, 480]}
          sizes="240px"
          fit="cover"
        />
        <Image
          slot="image4"
          src={carousel4Image}
          alt="Fizz Kidz Essendon gallery photo 4"
          class="h-60 w-60 rounded-md object-cover"
          width={240}
          height={240}
          widths={[240, 480]}
          sizes="240px"
          fit="cover"
        />
        <Image
          slot="image5"
          src={carousel5Image}
          alt="Fizz Kidz Essendon gallery photo 5"
          class="h-60 w-60 rounded-md object-cover"
          width={240}
          height={240}
          widths={[240, 480]}
          sizes="240px"
          fit="cover"
        />
      </ImageCarousel>
    </section>
    <section>
      <GoogleReviews
        title="Hear what our parents have to say!"
        location="essendon"
      />
    </section>
  </div>
  <LocationDetails studio="essendon" />
  </main>
</Layout>
