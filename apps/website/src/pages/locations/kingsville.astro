---
import PageIntro from "@/components/page-intro.astro";
import { BreadcrumbWrapper } from "@/components/react/breadcrumb-wrapper";
import Layout from "@/layout/Layout.astro";
import { websitePagesLocationsKingsvilleJpg as kingsville } from "@/data/website-images";
import { websitePagesLocationsKingsvilleBirthdayJpg as birthday } from "@/data/website-images";
import { websitePagesLocationsKingsvilleHolidayProgramsJpg as holidayPrograms } from "@/data/website-images";
import { websitePagesLocationsKingsvilleContactJpg as contact } from "@/data/website-images";
import { websitePagesLocationsKingsvilleSlimeJpg as slime } from "@/data/website-images";
import Image from "@/components/image.astro";
import CardWithImage from "@/components/card-with-image.astro";
import ImageCarousel from "@/components/react/image-carousel";
import GoogleReviews from "@/components/google-reviews.astro";
import LocationDetails from "@/components/location-details.astro";

import { websitePagesLocationsKingsvilleKingsville1Jpg as carousel1Image } from "@/data/website-images";
import { websitePagesLocationsKingsvilleKingsville2Jpg as carousel2Image } from "@/data/website-images";
import { websitePagesLocationsKingsvilleKingsville3Jpg as carousel3Image } from "@/data/website-images";
import { websitePagesLocationsKingsvilleKingsville4Jpg as carousel4Image } from "@/data/website-images";
import { websitePagesLocationsKingsvilleKingsville5Jpg as carousel5Image } from "@/data/website-images";
import { menu } from "@/components/react/navigation/navigation-menu";
import { createLocationSchemas } from "@/utils/seo";

const description =
  "Visit Fizz Kidz Kingsville for hosted kids birthday parties, school holiday programs and hands-on slime, science, art and craft activities in Melbourne's west.";
---

<Layout
  title="Kids Parties & Holiday Programs in Kingsville | Fizz Kidz"
  description={description}
  schema={createLocationSchemas("kingsville")}
>
  <main>
  <div class="m-auto block max-w-[1380px] px-5 pt-4">
    <BreadcrumbWrapper
      client:idle
      items={[
        {
          type: "link",
          title: "Locations",
          path: "/locations",
        },
        {
          type: "dropdown",
          title: "Kingsville",
          items: menu[5].items,
        },
      ]}
    />
    <PageIntro
      type="image"
      image={kingsville}
      imageAlt="A picture of the kingsville studio"
      subtitle="Fizz Kidz in Melbourne's West!"
      color="purple"
      actionButtonPath="/contact-us"
      actionButtonText="Get in touch"
    >
      <span slot="title">Fizz Kidz Kingsville Studio</span>
      <span slot="content"
        >Our brand-new Kingsville studio is a bright, engaging space designed
        for hands-on creativity, where kids can explore, experiment, and bring
        their ideas to life!
      </span>
    </PageIntro>
  </div>
  <div class="m-auto block max-w-[1380px] px-5">
    <p class="mt-16 text-center font-lilita text-5xl sm:mt-32">
      Brand-New Creative Hub in the Heart of Kingsville!
    </p>
    <section
      class="my-12 flex flex-col-reverse gap-8 md:pb-12 md:pt-16 lg:flex-row"
    >
      <div class="px-0 sm:px-12 lg:w-1/2">
        <Image
          class="rounded-2xl object-contain shadow-green-sm sm:shadow-green-md"
          src={slime}
          alt="Two Fizz Kids staff standing under an archway"
        />
      </div>
      <div class="flex flex-col justify-center lg:w-1/2">
        <p class="font-bold">Fizz Kidz Kingsville Studio</p>
        <p>238 Somerville Rd, Kingsville VIC 3012</p>
        <p class="mt-4 font-bold">Phone</p>
        <p><a href="tel:0390598144">(03) 9059 8144</a></p>
        <p class="mt-4 font-bold">Email</p>
        <p>
          <a href="mailto:bookings@fizzkidz.com.au">bookings@fizzkidz.com.au</a>
        </p>
        <p class="mt-4 font-bold">About Fizz Kidz Kingsville</p>
        <p>
          Our brand-new Kingsville studio is the perfect place for kids to
          unleash their creativity, have fun, and get messy!
          <ul class="mb-4 list-disc pl-4">
            <li>
              Conveniently located on Somerville Road, making it easy to access.
            </li>
            <li>A large, open space for kids to dance, create, and explore.</li>
            <li>
              A cozy café just meters away, perfect for parents to grab a
              coffee!
            </li>
            <li>
              Ample parking available nearby for easy drop-offs and pick-ups.
            </li>
            <li>
              We're thrilled to bring the magic of Fizz Kidz to Melbourne's
              west—come celebrate, create, and have a blast with us in
              Kingsville!
            </li>
          </ul>
        </p>
      </div>
    </section>
    <section class="mb-12 md:mb-20">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3152.0633660584967!2d144.8752550775895!3d-37.81198473393911!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6ad667ed880855ef%3A0x4570623e7fb50814!2sFizz%20Kidz%20(Kingsville%2C%20VIC)!5e0!3m2!1sen!2sau!4v1742120947777!5m2!1sen!2sau"
        width="100%"
        height="450"
        style="border:0;border-radius:12px"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </section>
    <section class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <a href="/birthday-parties">
        <CardWithImage
          className="group h-full w-full cursor-pointer hover:bg-gray-50"
          image={birthday}
          imageAlt="Kids holding slime"
        >
          <div slot="content" class="p-8 group-hover:cursor-pointer">
            <p class="mb-4 font-lilita text-2xl text-[#9044E2]">
              Birthday Parties
            </p>
            <p class="font-gotham text-lg">
              Celebrate with a fun-filled, hands-on party at Fizz Kidz
              Kingsville,
              where kids create and take home amazing creations!
            </p>
          </div>
        </CardWithImage>
      </a>
      <a href="/holiday-programs">
        <CardWithImage
          className="group h-full w-full cursor-pointer hover:bg-gray-50"
          image={holidayPrograms}
          imageAlt="Kids holding slime"
        >
          <div slot="content" class="p-8">
            <p class="mb-4 font-lilita text-2xl text-[#9044E2]">
              Holiday Programs
            </p>
            <p class="font-gotham text-lg">
              Keep your kids engaged and having fun during the holidays at Fizz
              Kidz Kingsville! Come and enjoy exciting new hands-on activities
              that spark your kids imagination!
            </p>
          </div>
        </CardWithImage>
      </a>
      <a href="/contact-us">
        <CardWithImage
          className="group h-full w-full cursor-pointer hover:bg-gray-50"
          image={contact}
          imageAlt="Kids holding slime"
        >
          <div slot="content" class="p-8">
            <p class="mb-4 font-lilita text-2xl text-[#9044E2]">Contact Us</p>
            <p class="font-gotham text-lg">
              Have questions or would like to chat? Get in touch with our
              Kingsville team, we would love to help!
            </p>
          </div>
        </CardWithImage>
      </a>
    </section>
    <section class="mt-24">
      <p class="text-center font-lilita text-3xl">Kingsville Studio Gallery</p>
      <ImageCarousel
        client:idle
        loop
        imageSlots={["image1", "image2", "image3", "image4", "image5"]}
      >
        <Image
          slot="image1"
          src={carousel1Image}
          alt="Fizz Kidz Kingsville gallery photo 1"
          class="h-60 w-60 rounded-md object-cover"
          width={240}
          height={240}
          widths={[240, 480]}
          sizes="240px"
          fit="cover"
        />
        <Image
          slot="image2"
          src={carousel2Image}
          alt="Fizz Kidz Kingsville gallery photo 2"
          class="h-60 w-60 rounded-md object-cover"
          width={240}
          height={240}
          widths={[240, 480]}
          sizes="240px"
          fit="cover"
        />
        <Image
          slot="image3"
          src={carousel3Image}
          alt="Fizz Kidz Kingsville gallery photo 3"
          class="h-60 w-60 rounded-md object-cover"
          width={240}
          height={240}
          widths={[240, 480]}
          sizes="240px"
          fit="cover"
        />
        <Image
          slot="image4"
          src={carousel4Image}
          alt="Fizz Kidz Kingsville gallery photo 4"
          class="h-60 w-60 rounded-md object-cover"
          width={240}
          height={240}
          widths={[240, 480]}
          sizes="240px"
          fit="cover"
        />
        <Image
          slot="image5"
          src={carousel5Image}
          alt="Fizz Kidz Kingsville gallery photo 5"
          class="h-60 w-60 rounded-md object-cover"
          width={240}
          height={240}
          widths={[240, 480]}
          sizes="240px"
          fit="cover"
        />
      </ImageCarousel>
    </section>
    <section>
      <GoogleReviews
        title="Hear what our parents have to say!"
        location="kingsville"
      />
    </section>
  </div>
  <LocationDetails studio="kingsville" />
  </main>
</Layout>
