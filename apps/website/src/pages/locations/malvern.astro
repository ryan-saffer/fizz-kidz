---
import PageIntro from "@/components/page-intro.astro";
import { BreadcrumbWrapper } from "@/components/react/breadcrumb-wrapper";
import Layout from "@/layout/Layout.astro";
import { websitePagesLocationsMalvernJpg as malvern } from "@/data/website-images";
import { websitePagesLocationsKingsvilleBirthdayJpg as birthday } from "@/data/website-images";
import { websitePagesLocationsKingsvilleHolidayProgramsJpg as holidayPrograms } from "@/data/website-images";
import { websitePagesLocationsKingsvilleContactJpg as contact } from "@/data/website-images";
import { websitePagesLocationsKingsvilleSlimeJpg as slime } from "@/data/website-images";
import Image from "@/components/image.astro";
import CardWithImage from "@/components/card-with-image.astro";
import ImageCarousel from "@/components/react/image-carousel";
import GoogleReviews from "@/components/google-reviews.astro";
import LocationDetails from "@/components/location-details.astro";

import { websitePagesLocationsMalvernMalvern1Jpg as carousel1Image } from "@/data/website-images";
import { websitePagesLocationsMalvernMalvern2Jpg as carousel2Image } from "@/data/website-images";
import { websitePagesLocationsMalvernMalvern3Jpg as carousel3Image } from "@/data/website-images";
import { websitePagesLocationsMalvernMalvern4Jpg as carousel4Image } from "@/data/website-images";
import { websitePagesLocationsMalvernMalvern5Jpg as carousel5Image } from "@/data/website-images";
import { menu } from "@/components/react/navigation/navigation-menu";
import { createLocationSchemas } from "@/utils/seo";

const description =
  "Visit Fizz Kidz Malvern for hosted kids birthday parties, school holiday programs and hands-on slime, science, art and craft activities in Melbourne's inner south-east.";
---

<Layout
  title="Kids Parties & Holiday Programs in Malvern | Fizz Kidz"
  description={description}
  schema={createLocationSchemas("malvern")}
>
  <main>
  <div class="m-auto block max-w-[1380px] px-5 pt-4">
    <BreadcrumbWrapper
      client:idle
      items={[
        {
          type: "link",
          title: "Locations",
          path: "/locations",
        },
        {
          type: "dropdown",
          title: "Malvern",
          items: menu[5].items,
        },
      ]}
    />
    <PageIntro
      type="image"
      image={malvern}
      imageAlt="A picture of the malvern studio"
      subtitle="The Ultimate Kids' Destination of Fun"
      color="purple"
      actionButtonPath="/contact-us"
      actionButtonText="Get in touch"
    >
      <span slot="title">Fizz Kidz Malvern Studio</span>
      <span slot="content"
        >Filled with colour, laughter and fun, Fizz Kidz Malvern brings joy to
        every child who enters!
      </span>
    </PageIntro>
    <p class="mt-36 text-center font-lilita text-5xl">
      Creativity & fun in the heart of Malvern!
    </p>
    <section
      class="my-12 flex flex-col-reverse gap-8 md:pb-12 md:pt-16 lg:flex-row"
    >
      <div class="px-0 sm:px-12 lg:w-1/2">
        <Image
          class="rounded-2xl object-contain shadow-green-sm sm:shadow-green-md"
          src={slime}
          alt="Two Fizz Kids staff standing under an archway"
        />
      </div>
      <div class="flex flex-col justify-center lg:w-1/2">
        <p class="font-bold">Fizz Kidz Malvern Studio</p>
        <p>20 Glenferrie Road, Malvern VIC 3144</p>
        <p class="mt-4 font-bold">Phone</p>
        <p><a href="tel:0390598144">(03) 9059 8144</a></p>
        <p class="mt-4 font-bold">Email</p>
        <p>
          <a href="mailto:bookings@fizzkidz.com.au">bookings@fizzkidz.com.au</a>
        </p>
        <p class="mt-4 font-bold">About Fizz Kidz Malvern</p>
        <p>
          Our stunning Malvern studio is colourful and bright with lots of
          natural light streaming through.
          <ul class="mb-4 list-disc pl-4">
            <li>
              Located conveniently on Glenferrie Road, there;s lots of cafes and
              shops nearby!
            </li>
            <li>Accommodate up to 28 children at birthday parties</li>
            <li>
              Cafe for parents:
              <ul class="mb-4 list-[circle] pl-6">
                <li>
                  Green Goose is conveniently located right around the corner.
                  Parents are welcome to grab a coffee, or arrange a tab for
                  parents.
                </li>
              </ul>
            </li>
          </ul>
        </p>
      </div>
    </section>
    <section class="mb-12 md:mb-20">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3149.8249111086625!2d145.02563537759087!3d-37.86438703693589!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6ad66a1e274963f7%3A0x1a05f7f5a3893474!2sFizz%20Kidz%20(Malvern)!5e0!3m2!1sen!2sau!4v1742119922446!5m2!1sen!2sau"
        width="100%"
        height="450"
        style="border:0;border-radius:12px"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </section>
    <section class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <a href="/birthday-parties">
        <CardWithImage
          className="group h-full w-full cursor-pointer"
          image={birthday}
          imageAlt="Kids holding slime"
        >
          <div
            slot="content"
            class="p-8 group-hover:cursor-pointer group-hover:bg-gray-50"
          >
            <p class="mb-4 font-lilita text-2xl text-[#9044E2]">
              Birthday Parties
            </p>
            <p class="font-gotham text-lg">
              Host a memorable, action-packed birthday at Fizz Kidz Malvern,
              where kids make and take home their very own awesome creations!
            </p>
          </div>
        </CardWithImage>
      </a>
      <a href="/holiday-programs">
        <CardWithImage
          className="group h-full w-full cursor-pointer"
          image={holidayPrograms}
          imageAlt="Kids holding slime"
        >
          <div slot="content" class="p-8 group-hover:bg-gray-50">
            <p class="mb-4 font-lilita text-2xl text-[#9044E2]">
              Holiday Programs
            </p>
            <p class="font-gotham text-lg">
              Keep your kids entertained during the holidays with Fizz Kidz
              Malvern programs, as we run amazing hands-on activities and
              creative projects that bring loads of fun!
            </p>
          </div>
        </CardWithImage>
      </a>
      <a href="/contact-us">
        <CardWithImage
          className="group h-full w-full cursor-pointer"
          image={contact}
          imageAlt="Kids holding slime"
        >
          <div slot="content" class="p-8 group-hover:bg-gray-50">
            <p class="mb-4 font-lilita text-2xl text-[#9044E2]">Contact Us</p>
            <p class="font-gotham text-lg">
              Have questions or would like to chat? Get in touch with our
              Malvern team, we would love to help!
            </p>
          </div>
        </CardWithImage>
      </a>
    </section>
    <section class="mt-24">
      <p class="text-center font-lilita text-3xl">Malvern Studio Gallery</p>
      <ImageCarousel
        client:idle
        loop
        imageSlots={["image1", "image2", "image3", "image4", "image5"]}
      >
        <Image
          slot="image1"
          src={carousel1Image}
          alt="Fizz Kidz Malvern gallery photo 1"
          class="h-60 w-60 rounded-md object-cover"
          width={240}
          height={240}
          widths={[240, 480]}
          sizes="240px"
          fit="cover"
        />
        <Image
          slot="image2"
          src={carousel2Image}
          alt="Fizz Kidz Malvern gallery photo 2"
          class="h-60 w-60 rounded-md object-cover"
          width={240}
          height={240}
          widths={[240, 480]}
          sizes="240px"
          fit="cover"
        />
        <Image
          slot="image3"
          src={carousel3Image}
          alt="Fizz Kidz Malvern gallery photo 3"
          class="h-60 w-60 rounded-md object-cover"
          width={240}
          height={240}
          widths={[240, 480]}
          sizes="240px"
          fit="cover"
        />
        <Image
          slot="image4"
          src={carousel4Image}
          alt="Fizz Kidz Malvern gallery photo 4"
          class="h-60 w-60 rounded-md object-cover"
          width={240}
          height={240}
          widths={[240, 480]}
          sizes="240px"
          fit="cover"
        />
        <Image
          slot="image5"
          src={carousel5Image}
          alt="Fizz Kidz Malvern gallery photo 5"
          class="h-60 w-60 rounded-md object-cover"
          width={240}
          height={240}
          widths={[240, 480]}
          sizes="240px"
          fit="cover"
        />
      </ImageCarousel>
    </section>
    <section>
      <GoogleReviews
        title="Hear what our parents have to say!"
        location="malvern"
      />
    </section>
  </div>
  <LocationDetails studio="malvern" />
  </main>
</Layout>
