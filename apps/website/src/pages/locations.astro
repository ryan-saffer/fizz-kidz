---
import { ArrowDown, ArrowRight } from "lucide-react";
import { BreadcrumbWrapper } from "@/components/react/breadcrumb-wrapper";
import Image from "@/components/image.astro";
import HomeDecal from "@/components/home/home-decal.astro";
import StudioExplorer from "@/components/locations/studio-explorer.astro";
import Layout from "@/layout/Layout.astro";
import { websitePagesLocationsEssendonJpg as essendon, websitePagesLocationsCheltenhamJpg as cheltenham } from "@/data/website-images";
import { PUBLIC_STUDIOS } from "@/utils/studios";
import { createBreadcrumbSchema, createLocationsListSchema } from "@/utils/seo";
import "@/components/locations/locations.css";

const description =
  "Find Fizz Kidz studios in Balwyn, Cheltenham, Essendon, Geelong, Kingsville, Malvern and Werribee for kids birthday parties, holiday programs and creative activities.";
---

<Layout
  title="Kids Party & Holiday Program Locations | Fizz Kidz"
  description={description}
  schema={[
    createLocationsListSchema(),
    createBreadcrumbSchema("/locations/", [
      { name: "Home", path: "/" },
      { name: "Locations", path: "/locations/" },
    ]),
  ]}
>
  <main class="locations-page">
    <section class="locations-hero" aria-labelledby="locations-heading">
      <div class="locations-breadcrumb locations-container">
        <BreadcrumbWrapper items={[{ type: "link", title: "Locations", path: "/locations/" }]} />
      </div>
      <div class="locations-hero-inner locations-container">
        <div class="locations-hero-copy">
          <p class="locations-eyebrow">OUR LOCATIONS · MELBOURNE &amp; GEELONG</p>
          <h1 id="locations-heading">Big fun.<br />Local <span>fizz.</span></h1>
          <p>A little slime. A lot of smiles. Find your local Fizz Kidz studio and come make something awesome.</p>
          <a class="locations-button" href="#studio-explorer">Find your studio <ArrowDown size={18} aria-hidden="true" /></a>
        </div>
        <div class="locations-collage">
          <div class="locations-photo-blob" aria-hidden="true"></div>
          <figure class="locations-studio-photo">
            <Image src={essendon} alt="Colourful party tables and creative spaces inside Fizz Kidz Essendon" width={850} sizes="(max-width: 700px) 85vw, 44vw" loading="eager" fetchpriority="high" />
          </figure>
          <figure class="locations-party-photo">
            <Image src={cheltenham} alt="Inside the Fizz Kidz Cheltenham studio" width={400} sizes="(max-width: 700px) 40vw, 20vw" loading="eager" />
            <figcaption>HAPPY PLACE FOUND!</figcaption>
          </figure>
          <div class="locations-count"><strong>{PUBLIC_STUDIOS.length}</strong><span>studios.<br />so much fun.</span></div>
          <HomeDecal kind="bolt" class="locations-bolt" />
          <HomeDecal kind="smile" class="locations-smile" />
          <svg class="locations-doodle" viewBox="0 0 180 100" fill="none" aria-hidden="true"><path d="M5 30C70-5 112 18 93 46S28 45 63 22 143 28 162 78m-25-8 28 12 9-30" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </div>
      </div>
      <svg class="locations-wave" viewBox="0 0 1440 70" preserveAspectRatio="none" aria-hidden="true"><path d="M0 35Q220 0 480 35T960 35T1440 35V70H0Z" fill="#fff9ed" /></svg>
    </section>

    <section class="locations-explore" id="studio-explorer" aria-labelledby="explorer-heading">
      <div class="locations-container">
        <div class="locations-section-heading">
          <div>
            <p class="locations-eyebrow">PICK YOUR HAPPY PLACE</p>
            <h2 id="explorer-heading">Where will you <span>fizz?</span></h2>
          </div>
          <p>Seven studios, each with its own personality.<br class="hidden md:block" /> Tap a location and take a peek inside.</p>
        </div>
        <StudioExplorer />
        <p class="locations-map-note">Big celebrations, school holiday adventures and everyday creativity, closer to home.</p>
      </div>
    </section>

    <section class="locations-next" aria-labelledby="locations-next-heading">
      <div class="locations-container locations-next-inner">
        <HomeDecal kind="jar" class="locations-jar" />
        <div>
          <p class="locations-eyebrow">YOU BRING THE KIDS. WE BRING THE FIZZ.</p>
          <h2 id="locations-next-heading">Found your spot?<br /><span>Let's make some memories.</span></h2>
          <p>Birthday candles or school holiday creations? There's plenty of fun waiting at your local studio.</p>
          <div class="locations-next-actions">
            <a class="locations-button locations-button-yellow" href="/birthday-parties/">Explore birthday parties <ArrowRight size={18} aria-hidden="true" /></a>
            <a class="locations-text-link" href="/holiday-programs/">Find a holiday program <ArrowRight size={18} aria-hidden="true" /></a>
          </div>
        </div>
        <HomeDecal kind="cloud" class="locations-cloud" />
      </div>
    </section>
  </main>
</Layout>
