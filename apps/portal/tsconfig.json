{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "skipLibCheck": true,

        "paths": {
            "@app/*": ["./src/app/*"],
            "@features/*": ["./src/features/*"],
            "@integrations/*": ["./src/integrations/*"],
            "@session/*": ["./src/session/*"],
            "@shared/*": ["./src/shared/*"],
            "@server/*": ["../server/src/*"],
            "@/*": ["../server/src/*"],
            "@fizz-kidz/core": ["../../packages/core/src"],
            "@fizz-kidz/ui": ["../../packages/ui/src"]
        },

        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noUncheckedSideEffectImports": false,
        "noEmit": true,
        "types": ["*"],
        "jsx": "react-jsx",
        "allowJs": true,

        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": ["src/", "../server/declarations/index.d.ts", "../server/src/environment.d.ts"]
}
