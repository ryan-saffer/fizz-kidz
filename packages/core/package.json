{
    "name": "@fizz-kidz/core",
    "version": "1.0.0",
    "description": "Shared value and types to be used across React and Functions",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "vp pack",
        "build:watch": "vp pack --watch",
        "dev:typecheck": "vp exec tsc --noEmit --watch --preserveWatchOutput"
    },
    "author": "Ryan Saffer",
    "license": "ISC",
    "dependencies": {
        "@portabletext/types": "^4.0.2",
        "zod": "3.25.76"
    },
    "devDependencies": {
        "firebase-admin": "^11.11.0"
    }
}
