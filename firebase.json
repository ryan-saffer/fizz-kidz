{
    "hosting": {
        "public": "apps/portal/dist",
        "rewrites": [
            {
                "source": "/api{,/**}",
                "function": {
                    "functionId": "api",
                    "region": "australia-southeast1"
                }
            },
            {
                "source": "/forms{,/**}",
                "function": {
                    "functionId": "api",
                    "region": "australia-southeast1"
                }
            },
            {
                "source": "/invite/**",
                "destination": "/invitation.html"
            },
            {
                "source": "**",
                "destination": "/index.html"
            }
        ],
        "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
        "predeploy": ["sh ./apps/portal/predeploy.sh"]
    },
    "emulators": {
        "functions": {
            "port": 5001
        },
        "firestore": {
            "port": 8080
        },
        "hosting": {
            "port": 5002
        },
        "ui": {
            "enabled": true,
            "port": 4000
        },
        "singleProjectMode": true,
        "pubsub": {
            "port": 8085
        }
    },
    "functions": {
        "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"],
        "source": "apps/server",
        "ignore": [
            "node_modules",
            ".git",
            "firebase-debug.log",
            "firebase-debug.*.log",
            "pubsub-debug.log",
            "ui-debug.log",
            "**/coverage/**",
            "**/src/**",
            "**/*.tsbuildinfo"
        ]
    }
}
