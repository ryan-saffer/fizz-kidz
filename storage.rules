rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /anaphylaxisPlans/{filename} {
      allow write: if true;
    }

    match /anaphylaxisPlans/{id}/{filename} {
    	allow read: if request.auth != null
    }

  	match /invitations/{allPaths=**} {
    	allow read: if true;
    }

    match /invitations-v2/{allPaths=**} {
    	allow read: if true;
    }

    match /payroll/{allPaths=**} {
    	allow read, write: if request.auth != null
    }
  }
}
